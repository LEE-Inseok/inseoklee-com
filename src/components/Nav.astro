---
const currentPath = Astro.url.pathname;

interface SubLink { label: string; href: string; }
interface NavLink { label: string; href: string; sub?: SubLink[]; }

const navLinks: NavLink[] = [
  { label: 'About',    href: '/about' },
  {
    label: 'Research', href: '/research',
    sub: [
      { label: 'System Engineering', href: '/research#system-engineering' },
      { label: 'Simulation & Optimization', href: '/research#simulation' },
      { label: 'ALD',                href: '/research#ald' },
      { label: 'Publications',       href: '/research#publications' },
    ],
  },
  {
    label: 'AI Engineering', href: '/development',
    sub: [
      { label: 'AI Agent Engineering', href: '/development#agent' },
      { label: 'Projects',             href: '/development#projects' },
    ],
  },
  {
    label: 'Achievements', href: '/recognition',
    sub: [
      { label: 'Awards',                   href: '/recognition#awards' },
      { label: 'Certifications',           href: '/recognition#certifications' },
      { label: 'Conference Presentations', href: '/recognition#presentations' },
      { label: 'Activities',               href: '/recognition#activities' },
    ],
  },
  { label: 'News',        href: '/news' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 h-16 transition-all duration-200"
  style="background-color: var(--bg);"
>
  <div class="container-site h-full flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 text-sm font-medium tracking-tight"
      style="color: var(--ink);"
      aria-label="Inseok Lee — Home"
    >
      <span style="color: var(--accent);">╳</span>
      <span>Inseok Lee</span>
    </a>

    <!-- Center nav links -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(({ label, href, sub }) => {
        const active = isActive(href);
        const hasSub = !!sub && sub.length > 0;
        return (
          <li class={`relative top-nav-item ${hasSub ? 'has-sub' : ''}`}>
            {active && <span class="nav-active-line" />}
            <a
              href={href}
              class="top-nav-link relative pt-1 pb-1 text-sm font-medium tracking-tight transition-colors duration-150 inline-flex items-center gap-1"
              style={active ? 'color: var(--ink);' : 'color: var(--muted);'}
              aria-current={active ? 'page' : undefined}
              aria-haspopup={hasSub ? 'menu' : undefined}
              aria-expanded={hasSub ? 'false' : undefined}
            >
              <span>{label}</span>
              {hasSub && <span class="top-nav-chevron" aria-hidden="true">▾</span>}
            </a>
            {hasSub && (
              <div class="top-nav-dropdown" role="menu" aria-label={`${label} subcategories`}>
                <ul>
                  {sub!.map(({ label: sLabel, href: sHref }) => (
                    <li>
                      <a
                        href={sHref}
                        role="menuitem"
                        class="top-nav-sub-link"
                        data-sub-href={sHref}
                      >
                        {sLabel}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        );
      })}
    </ul>

    <!-- Right utility buttons -->
    <div class="flex items-center gap-4">
      <!-- Dark-mode toggle — P2, wired up in future sprint -->
      <button
        aria-label="Toggle colour mode (coming soon)"
        class="hidden md:flex items-center justify-center w-8 h-8 text-sm transition-colors duration-150"
        style="color: var(--muted);"
        disabled
      >
        ☾
      </button>

      <a
        href="/contact"
        class="hidden md:inline-flex items-center px-4 h-8 text-xs uppercase tracking-widest transition-colors duration-150"
        style="border: 1px solid var(--border); color: var(--ink);"
        onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
        onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--ink)';"
      >
        Contact
      </a>

      <!-- Mobile hamburger placeholder -->
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="md:hidden flex flex-col gap-1 w-6"
        style="color: var(--ink);"
      >
        <span class="block w-full h-px" style="background: var(--ink);"></span>
        <span class="block w-full h-px" style="background: var(--ink);"></span>
        <span class="block w-3 h-px" style="background: var(--ink);"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-16 left-0 right-0 border-t"
    style="background-color: var(--bg); border-color: var(--border);"
  >
    <ul class="container-site py-6 flex flex-col gap-2">
      {navLinks.map(({ label, href }) => {
        const active = isActive(href);
        return (
          <li>
            <a
              href={href}
              class="block text-sm font-medium py-2"
              style={active ? 'color: var(--accent);' : 'color: var(--body);'}
            >
              {label}
            </a>
          </li>
        );
      })}
      <li>
        <a
          href="/contact"
          class="inline-block mt-2 px-4 py-2 text-xs uppercase tracking-widest"
          style="border: 1px solid var(--accent); color: var(--accent);"
        >
          Contact
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Mobile-only chrome fixes — both elements are md:hidden, so desktop is
     untouched by construction. */
  /* Hamburger: the visual is ~24x11px; extend the HIT AREA (not the visual)
     to ~56x43px so the only mobile nav entry point is comfortably tappable. */
  #mobile-menu-btn {
    position: relative;
  }
  #mobile-menu-btn::after {
    content: '';
    position: absolute;
    inset: -16px;
  }
  /* Menu panel lives inside the fixed nav — cap it to the visible viewport
     and let it scroll so Contact stays reachable on short/landscape screens.
     (vh fallback first; dvh tracks mobile browser chrome.) */
  #mobile-menu {
    max-height: calc(100vh - 4rem);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
  }

  /* Top nav link hover (works whether item has sub-menu or not) */
  .top-nav-link {
    position: relative;
  }
  .top-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }
  .top-nav-item:hover .top-nav-link::after {
    transform: scaleX(1);
  }
  .top-nav-item:hover .top-nav-link {
    color: var(--ink) !important;
  }

  /* Dropdown panel — hidden by default, opens via JS-driven data-state="open" */
  .top-nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 8px);
    min-width: 220px;
    padding: 0.5rem 0;
    margin-top: 8px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    pointer-events: none;
    z-index: 100;
  }
  .top-nav-dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .top-nav-item.has-sub[data-state="open"] .top-nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  /* Bridge — covers the 8px gap below the trigger so cursor can travel down
     to the dropdown without firing mouseleave. Width = trigger only,
     so adjacent items' bridges never overlap. */
  .top-nav-item.has-sub::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 12px;
  }

  .top-nav-sub-link {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .top-nav-sub-link:hover {
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--ink);
  }
  .top-nav-sub-link[aria-current="true"] {
    background-color: var(--accent);
    color: #0A0A0A;
    font-weight: 700;
  }
  .top-nav-sub-link[aria-current="true"]:hover {
    background-color: var(--accent-dk);
    color: #0A0A0A;
  }

  /* Chevron next to has-sub triggers — rotates with dropdown state, not hover */
  .top-nav-chevron {
    display: inline-block;
    font-size: 0.6rem;
    line-height: 1;
    transform: translateY(1px);
    transition: transform 180ms ease;
  }
  .top-nav-item.has-sub[data-state="open"] .top-nav-chevron {
    transform: translateY(1px) rotate(180deg);
  }
</style>

<script>
  // Scroll effect: add backdrop-blur + border-bottom
  const nav = document.getElementById('main-nav');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (!nav) return;
    if (window.scrollY > 20) {
      nav.style.backdropFilter = 'blur(8px)';
      nav.style.backgroundColor = 'rgba(10, 10, 10, 0.85)';
      nav.style.borderBottom = '1px solid var(--border)';
    } else {
      nav.style.backdropFilter = 'none';
      nav.style.backgroundColor = 'var(--bg)';
      nav.style.borderBottom = 'none';
    }
  }, { passive: true });

  // Mobile menu toggle
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Highlight the dropdown sub-link that matches the current URL (path + hash)
  function markCurrentSubLink() {
    const current = window.location.pathname + window.location.hash;
    const currentNormalized = current.replace(/\/$/, '');
    document.querySelectorAll<HTMLAnchorElement>('.top-nav-sub-link[data-sub-href]').forEach((a) => {
      const target = (a.dataset.subHref ?? '').replace(/\/$/, '');
      if (target && target === currentNormalized) {
        a.setAttribute('aria-current', 'true');
      } else {
        a.removeAttribute('aria-current');
      }
    });
  }
  markCurrentSubLink();
  window.addEventListener('hashchange', markCurrentSubLink);
  window.addEventListener('popstate', markCurrentSubLink);

  // Top-nav dropdown — single-open policy, JS owns the state
  // (CSS reads [data-state="open"] only; no :hover dependency so overlapping
  //  pseudo-elements between adjacent items can't open two dropdowns at once.)
  const subItems = document.querySelectorAll<HTMLElement>('.top-nav-item.has-sub');

  subItems.forEach((item) => {
    const trigger = item.querySelector<HTMLElement>('.top-nav-link');
    if (!trigger) return;

    let closeTimer: number | null = null;

    function clearTimer() {
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    function openThis() {
      clearTimer();
      // Close any other open dropdown (single-pin policy)
      subItems.forEach((other) => {
        if (other !== item && other.dataset.state === 'open') {
          other.dataset.state = 'closed';
          other.querySelector<HTMLElement>('.top-nav-link')
            ?.setAttribute('aria-expanded', 'false');
        }
      });
      item.dataset.state = 'open';
      trigger!.setAttribute('aria-expanded', 'true');
    }

    function scheduleClose() {
      clearTimer();
      closeTimer = window.setTimeout(() => {
        item.dataset.state = 'closed';
        trigger!.setAttribute('aria-expanded', 'false');
        closeTimer = null;
      }, 120);  // grace period for cursor re-entry
    }

    item.addEventListener('mouseenter', openThis);
    item.addEventListener('mouseleave', scheduleClose);
    item.addEventListener('focusin', openThis);
    item.addEventListener('focusout', (e) => {
      const related = (e as FocusEvent).relatedTarget as Node | null;
      if (!related || !item.contains(related)) scheduleClose();
    });
  });
</script>
