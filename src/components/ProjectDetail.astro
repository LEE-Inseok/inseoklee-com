---
/**
 * ProjectDetail — the ONE template every project/research detail page uses.
 *
 * Layout, top to bottom:
 *   1. Header: back link · title · one-line summary · date
 *   2. Visuals — two layouts:
 *      · No captions → photo strip: always 3 slots (4:3). Missing photos render
 *        as dashed placeholders, so pages look consistent before content lands.
 *      · Any captions → figure stack: larger, full-width 4:3 figures with the
 *        caption beneath — for diagrams that need to be read. Clicking a figure
 *        opens a lightbox showing the high-res original (`full`), with zoom
 *        toggle and a download link.
 *   3. Body: markdown content following the standard section format
 *      (see src/content/&#42;/_TEMPLATE.md — Overview / My Role / Approach /
 *      Results / What I Learned)
 *   4. Tags
 */
type ImageEntry = string | { src: string; captionTitle?: string; caption?: string; full?: string };

export interface Props {
  backHref: string;
  backLabel: string;
  title: string;
  summary: string;
  date?: string;
  tags?: string[];
  images?: ImageEntry[];
}

const { backHref, backLabel, title, summary, date, tags, images = [] } = Astro.props;

// Normalise to { src, caption, full } so both frontmatter forms (bare string
// or object) render through one code path.
const figures = images.map((img) =>
  typeof img === 'string' ? ({ src: img } as Exclude<ImageEntry, string>) : img
);
const hasCaptions = figures.some((f) => f.caption || f.captionTitle);
const photoSlots = [0, 1, 2].map((i) => figures[i]?.src ?? null);
---

<div class="container-site py-16">
  <!-- 1. Header -->
  <header class="mb-10 border-b pb-8" style="border-color: var(--border);">
    <a
      href={backHref}
      class="section-label transition-colors max-sm:inline-block max-sm:py-3 max-sm:-my-3"
      style="color: var(--muted);"
      onmouseover="this.style.color='var(--accent)';"
      onmouseout="this.style.color='var(--muted)';"
    >← {backLabel}</a>
    <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">{title}</h1>
    <p class="mt-3 text-base max-w-2xl" style="color: var(--muted);">{summary}</p>
    {date && <p class="mt-3 section-label">{date}</p>}
  </header>

  <!-- 2a. Figure stack — larger, captioned, natural aspect (diagrams) -->
  {hasCaptions ? (
    <div class="flex flex-col gap-12 max-w-4xl mb-16">
      {figures.map((fig, i) => (
        <figure class="m-0" data-reveal style={`transition-delay: ${i * 70}ms`}>
          <button
            type="button"
            class="block w-full m-0 p-0 cursor-zoom-in"
            style="border: 0; background: none;"
            data-lightbox={encodeURI(fig.full ?? fig.src)}
            aria-label={`Enlarge figure ${i + 1}`}
          >
            <img
              src={encodeURI(fig.src)}
              alt={fig.caption ? `${title} — ${fig.caption}` : `${title} — figure ${i + 1}`}
              class="w-full object-cover"
              style="aspect-ratio: 4 / 3; border: 1px solid var(--border); background: var(--surface);"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
          {(fig.captionTitle || fig.caption) && (
            <figcaption class="mt-4 max-w-2xl">
              <p class="m-0">
                <span class="section-label" style="color: var(--accent);">Fig. {i + 1}</span>
                {fig.captionTitle && (
                  <span class="ml-2 text-sm font-medium" style="color: var(--ink);">{fig.captionTitle}</span>
                )}
              </p>
              {fig.caption && (
                <p class="m-0 mt-1.5 text-sm leading-relaxed" style="color: var(--muted);">{fig.caption}</p>
              )}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  ) : (
  <!-- 2b. Photo strip — always 3 slots -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-5xl mb-14">
    {photoSlots.map((img, i) =>
      img ? (
        <figure class="m-0" data-reveal style={`transition-delay: ${i * 70}ms`}>
          <img
            src={encodeURI(img)}
            alt={`${title} — photo ${i + 1}`}
            class="w-full object-cover"
            style="aspect-ratio: 4 / 3; border: 1px solid var(--border); background: var(--surface);"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
      ) : (
        <div
          class="flex items-center justify-center"
          data-reveal
          style={`aspect-ratio: 4 / 3; border: 1px dashed var(--border); transition-delay: ${i * 70}ms`}
        >
          <span class="text-xs uppercase tracking-widest" style="color: var(--muted);">Photo {i + 1} — coming soon</span>
        </div>
      )
    )}
  </div>
  )}

  <!-- 3. Body — markdown following the standard section format -->
  <article class="article max-w-2xl">
    <slot />
  </article>

  <!-- 4. Tags -->
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap mt-12 max-w-2xl">
      {tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>
  )}

  <!-- 5. Lightbox — opened by clicking a figure in the stack. Shows the
       high-res original; click the image to toggle fit ↔ 100% zoom. -->
  {hasCaptions && (
    <div id="lightbox" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Image viewer">
      <div data-lb-backdrop class="absolute inset-0" style="background: rgba(0, 0, 0, 0.88);"></div>
      <div data-lb-scroll class="absolute inset-0 overflow-auto flex items-center justify-center p-6">
        <img
          data-lb-img
          src=""
          alt="Full-size figure"
          class="cursor-zoom-in"
          style="max-width: 92vw; max-height: 88vh; object-fit: contain; border: 1px solid var(--border);"
        />
      </div>
      <div class="absolute top-4 right-4 flex gap-2">
        <a
          data-lb-download
          href=""
          download
          class="px-3 py-2 text-xs uppercase tracking-widest no-underline"
          style="color: var(--ink); background: var(--surface); border: 1px solid var(--border);"
        >Download original</a>
        <button
          type="button"
          data-lb-close
          class="px-3 py-2 text-xs uppercase tracking-widest cursor-pointer"
          style="color: var(--ink); background: var(--surface); border: 1px solid var(--border);"
        >Close ✕</button>
      </div>
    </div>
  )}
</div>

<script>
  const lb = document.getElementById('lightbox');
  if (lb) {
    const img = lb.querySelector('[data-lb-img]') as HTMLImageElement;
    const dl = lb.querySelector('[data-lb-download]') as HTMLAnchorElement;
    const scroller = lb.querySelector('[data-lb-scroll]') as HTMLElement;

    const open = (src: string) => {
      img.src = src;
      img.classList.remove('lb-zoomed');
      dl.href = src;
      dl.setAttribute('download', src.split('/').pop() ?? 'figure.png');
      lb.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.add('hidden');
      img.src = '';
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((btn) => {
      btn.addEventListener('click', () => open(btn.dataset.lightbox!));
    });

    // Click image → toggle fit ↔ 100% (scroll to pan when zoomed)
    img.addEventListener('click', (e) => {
      e.stopPropagation();
      const zoomed = img.classList.toggle('lb-zoomed');
      if (zoomed) {
        img.style.maxWidth = 'none';
        img.style.maxHeight = 'none';
        img.style.cursor = 'zoom-out';
        scroller.style.alignItems = 'flex-start';
        scroller.style.justifyContent = 'flex-start';
      } else {
        img.style.maxWidth = '92vw';
        img.style.maxHeight = '88vh';
        img.style.cursor = 'zoom-in';
        scroller.style.alignItems = 'center';
        scroller.style.justifyContent = 'center';
      }
    });

    lb.querySelector('[data-lb-backdrop]')!.addEventListener('click', close);
    scroller.addEventListener('click', (e) => { if (e.target === scroller) close(); });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lb.classList.contains('hidden')) close();
    });
  }
</script>
