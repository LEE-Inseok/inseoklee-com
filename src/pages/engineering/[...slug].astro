---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('engineering');
  // Static pages already exist for these slugs — avoid route collisions.
  return entries
    .filter((entry) => !['sbh-thermal', 'ccpp-lohc'].includes(entry.slug))
    .map((entry) => ({
      params: { slug: entry.slug },
      props:  { entry },
    }));
}

type Props = { entry: CollectionEntry<'engineering'> };
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, tags, date, images } = entry.data;
---

<BaseLayout title={`${title} — Inseok Lee`} description={summary} section="engineering">
  <ProjectDetail
    backHref="/research"
    backLabel="Research"
    title={title}
    summary={summary}
    date={date}
    tags={tags}
    images={images}
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
