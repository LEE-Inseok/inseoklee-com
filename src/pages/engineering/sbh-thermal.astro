---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('engineering', 'sbh-thermal');
if (!entry) throw new Error('Entry sbh-thermal not found');
const { Content } = await entry.render();
const { title, summary, tags, date, images } = entry.data;
---

<BaseLayout title={`${title} — Inseok Lee`} description={summary} section="engineering">
  <ProjectDetail
    backHref="/research"
    backLabel="Research"
    title={title}
    summary={summary}
    date={date}
    tags={tags}
    images={images}
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
