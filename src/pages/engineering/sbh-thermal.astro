---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SBH Thermal Simulation — Engineering — Inseok Lee"
  description="Thermal modelling and scenario comparison for the SBH hydrogen generation system."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/engineering" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Engineering</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">SBH Thermal Simulation.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Thermal modelling · scenario comparison · heat recovery analysis
      </p>
    </header>

    <div class="max-w-2xl">
      <p class="text-base" style="color: var(--body);">
        [Engineering detail page — content coming in Day 4. Will include: 6 chapters with
        simulation methodology, scenario comparisons, and results.]
      </p>
    </div>
  </div>
</BaseLayout>
