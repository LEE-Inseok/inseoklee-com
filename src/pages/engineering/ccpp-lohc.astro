---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="CCPP-LOHC Optimization — Engineering — Inseok Lee"
  description="Multi-objective optimization of CCPP integrated with LOHC hydrogen carrier using NSGA-II."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/engineering" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Engineering</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">CCPP-LOHC Optimization.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Combined-cycle power plant · LOHC carrier · NSGA-II multi-objective optimization
      </p>
    </header>

    <div class="max-w-2xl">
      <p class="text-base" style="color: var(--body);">
        [Engineering detail page — content coming in Day 4. Will include: 7 chapters with
        process description, optimization setup, Pareto-front results, and interactive charts.]
      </p>
    </div>
  </div>
</BaseLayout>
