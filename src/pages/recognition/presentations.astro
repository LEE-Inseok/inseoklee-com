---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Presentations — Recognition — Inseok Lee"
  description="Conference and seminar presentations — slides and photos."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/recognition" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Recognition</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">Presentations.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Conference and seminar presentations — slide thumbnails and event photos.
      </p>
    </header>

    <div class="max-w-4xl">
      <p class="text-base" style="color: var(--body);">
        [Presentations grid coming in Day 5. Will include: card per presentation with
        conference/seminar name, title, 1-line summary, slide thumbnail or event photo, and date.]
      </p>
    </div>
  </div>
</BaseLayout>
