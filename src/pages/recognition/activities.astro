---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Activities — Recognition — Inseok Lee"
  description="Extracurricular activities including Sunset Marathon 2026."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/recognition" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Recognition</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">Activities.</h1>
    </header>

    <div class="max-w-4xl">
      <div class="card p-6 max-w-md">
        <span class="section-label">Sunset Marathon 2026</span>
        <h2 class="text-xl font-semibold mt-2" style="color: var(--ink);">Half Marathon</h2>
        <p class="text-2xl font-mono mt-3" style="color: var(--accent);">02:06:46</p>
        <p class="text-sm mt-2" style="color: var(--muted);">
          [3-photo gallery placeholder — photos to be added by user]
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
