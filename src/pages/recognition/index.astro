---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCollection } from 'astro:content';

const awards = (await getCollection('recognition-awards')).sort((a, b) => b.data.year - a.data.year);
const certifications = (await getCollection('recognition-certifications')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
const presentations = (await getCollection('recognition-presentations')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
const activities = (await getCollection('recognition-activities')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);

const navGroups = [
  { key: 'awards',         label: 'Awards',                   trigger: 'activate' as const, activateView: 'awards' },
  { key: 'certifications', label: 'Certifications',           trigger: 'activate' as const, activateView: 'certifications' },
  { key: 'presentations',  label: 'Conference Presentations', trigger: 'activate' as const, activateView: 'presentations' },
  { key: 'activities',     label: 'Activities',               trigger: 'activate' as const, activateView: 'activities' },
];
---

<BaseLayout
  title="Recognition — Inseok Lee"
  description="Awards, certifications, presentations, and activities."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Recognition</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Recognition.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Awards, certifications, conference presentations, and extracurricular activities.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          <CategoryNav
            groups={navGroups}
            defaultView="awards"
            ariaLabel="Recognition categories"
          />
        </div>
      </aside>

      <div class="flex-1 min-w-0">

        <!-- Awards -->
        <section data-view-panel="awards" hidden aria-labelledby="cn-awards-trigger">
          <h2 class="view-title">Awards</h2>
          <div class="flex flex-col max-w-2xl">
            {awards.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No awards recorded yet.</p>
            )}
            {awards.map((a) => (
              <div class="card flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="section-label">{a.data.year}</span>
                  <span class="section-label" style="color: var(--accent-dk);">{a.data.prize}</span>
                </div>
                <h4 class="card-title">{a.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{a.data.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Certifications -->
        <section data-view-panel="certifications" hidden aria-labelledby="cn-certifications-trigger">
          <h2 class="view-title">Certifications</h2>
          <div class="flex flex-col max-w-2xl">
            {certifications.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No certifications recorded yet.</p>
            )}
            {certifications.map((c) => (
              <div class="card flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="section-label">{c.data.issuer}</span>
                  <span class="section-label">{c.data.date}</span>
                </div>
                <h4 class="card-title">{c.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{c.data.summary}</p>
                {(c.data.verifyUrl || c.data.pdf) && (
                  <div class="flex flex-wrap gap-4 mt-1 text-sm">
                    {c.data.verifyUrl && <a href={c.data.verifyUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent-dk); text-decoration: underline;">Verify →</a>}
                    {c.data.pdf && <a href={c.data.pdf} target="_blank" rel="noopener noreferrer" style="color: var(--accent-dk); text-decoration: underline;">PDF ↓</a>}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Conference Presentations -->
        <section data-view-panel="presentations" hidden aria-labelledby="cn-presentations-trigger">
          <h2 class="view-title">Conference Presentations</h2>
          <div class="flex flex-col max-w-2xl">
            {presentations.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No conference presentations recorded yet.</p>
            )}
            {presentations.map((p) => (
              <div class="card flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="section-label">{p.data.conference}</span>
                  <span class="section-label">{p.data.date}</span>
                </div>
                <h4 class="card-title">{p.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{p.data.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Activities -->
        <section data-view-panel="activities" hidden aria-labelledby="cn-activities-trigger">
          <h2 class="view-title">Activities</h2>
          <div class="flex flex-col max-w-2xl">
            {activities.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No activities recorded yet.</p>
            )}
            {activities.map((act) => (
              <div class="card flex flex-col gap-2">
                <span class="section-label">{act.data.date}</span>
                <h4 class="card-title">{act.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{act.data.summary}</p>
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
  [data-view-panel] {
    transition: opacity 150ms ease;
  }
  [data-view-panel][hidden] {
    display: none;
  }
</style>
