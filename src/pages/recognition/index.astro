---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCollection } from 'astro:content';

const awards = (await getCollection('recognition-awards')).sort((a, b) => b.data.year - a.data.year);
const certifications = (await getCollection('recognition-certifications')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
const presentations = (await getCollection('recognition-presentations')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
const activities = (await getCollection('recognition-activities')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);

const navGroups = [
  { key: 'awards',         label: 'Awards',                   trigger: 'activate' as const, activateView: 'awards' },
  { key: 'certifications', label: 'Certifications',           trigger: 'activate' as const, activateView: 'certifications' },
  { key: 'presentations',  label: 'Conference Presentations', trigger: 'activate' as const, activateView: 'presentations' },
  { key: 'activities',     label: 'Activities',               trigger: 'activate' as const, activateView: 'activities' },
];
---

<BaseLayout
  title="Achievements — Inseok Lee"
  description="Awards, certifications, presentations, and activities."
  section="recognition"
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Achievements</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Achievements.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Awards, certifications, conference presentations, and extracurricular activities.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          <CategoryNav
            groups={navGroups}
            defaultView="awards"
            ariaLabel="Achievements categories"
          />
        </div>
      </aside>

      <div class="flex-1 min-w-0">

        <!-- Awards -->
        <section data-view-panel="awards" hidden aria-labelledby="cn-awards-trigger">
          <h2 class="view-title">Awards</h2>
          <div class="flex flex-col max-w-2xl">
            {awards.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No awards recorded yet.</p>
            )}
            {awards.map((a, i) => (
              <div class="card flex gap-5" data-reveal style={`transition-delay: ${i * 70}ms`}>
                <span class="row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex flex-col gap-2 min-w-0 flex-1">
                  <div class="flex items-center justify-between">
                    <span class="section-label">{a.data.year}</span>
                    <span class="section-label" style="color: var(--accent-dk);">{a.data.prize}</span>
                  </div>
                  <h4 class="card-title">{a.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{a.data.summary}</p>
                </div>
                {a.data.image && (
                  <div class="cert-thumbs" data-gallery>
                    <button
                      type="button"
                      class="activity-photo-btn cert-thumb-btn"
                      data-photo-src={a.data.image}
                      data-photo-index={0}
                      aria-label={`Open award certificate of ${a.data.title}`}
                    >
                      <img
                        src={a.data.image}
                        alt={`${a.data.title} — award certificate`}
                        class="cert-photo"
                        style="max-height: 9.5rem;"
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Certifications -->
        <section data-view-panel="certifications" hidden aria-labelledby="cn-certifications-trigger">
          <h2 class="view-title">Certifications</h2>
          <div class="flex flex-col max-w-2xl">
            {certifications.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No certifications recorded yet.</p>
            )}
            {certifications.map((c, i) => (
              <div class="card flex gap-5" data-reveal style={`transition-delay: ${i * 70}ms`}>
                <span class="row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex flex-col gap-2 min-w-0 flex-1">
                  <div class="flex items-center justify-between">
                    <span class="section-label">{c.data.issuer}</span>
                    <span class="section-label">{c.data.date}</span>
                  </div>
                  <h4 class="card-title">{c.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{c.data.summary}</p>
                </div>
                {c.data.images && c.data.images.length > 0 && (
                  <div class="cert-thumbs" data-gallery>
                    {c.data.images.map((src, j) => (
                      <button
                        type="button"
                        class="activity-photo-btn cert-thumb-btn"
                        data-photo-src={src}
                        data-photo-index={j}
                        aria-label={`Open certificate ${j + 1} of ${c.data.title}`}
                      >
                        <img
                          src={src}
                          alt={`${c.data.title} — certificate ${j + 1}`}
                          class="cert-photo"
                          style={`max-height: ${c.data.images!.length > 1 ? '6.5rem' : '9.5rem'};`}
                          loading="lazy"
                          decoding="async"
                        />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Conference Presentations -->
        <section data-view-panel="presentations" hidden aria-labelledby="cn-presentations-trigger">
          <h2 class="view-title">Conference Presentations</h2>
          <div class="flex flex-col max-w-2xl">
            {presentations.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No conference presentations recorded yet.</p>
            )}
            {presentations.map((p, i) => (
              <div class="card flex gap-5" data-reveal style={`transition-delay: ${i * 70}ms`}>
                <span class="row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex flex-col gap-2 min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-3 flex-wrap">
                    <span class="section-label">{p.data.conference}</span>
                    <div class="flex items-center gap-2 flex-wrap">
                      {p.data.type && <span class="presentation-badge presentation-badge--type">{p.data.type}</span>}
                      {p.data.status === 'scheduled' && <span class="presentation-badge presentation-badge--scheduled">Scheduled</span>}
                      <span class="section-label">{p.data.date}</span>
                    </div>
                  </div>
                  <h4 class="card-title">{p.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{p.data.summary}</p>
                  {p.data.images && p.data.images.length > 0 && (
                    <div class="activity-photos" data-gallery>
                      {p.data.images.map((src, j) => (
                        <button
                          type="button"
                          class="activity-photo-btn"
                          data-photo-src={src}
                          data-photo-index={j}
                          aria-label={`Open slide ${j + 1} of ${p.data.title}`}
                        >
                          <img
                            src={src}
                            alt={`${p.data.conference} — slide ${j + 1}`}
                            class="activity-photo"
                            loading="lazy"
                            decoding="async"
                          />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Activities -->
        <section data-view-panel="activities" hidden aria-labelledby="cn-activities-trigger">
          <h2 class="view-title">Activities</h2>
          <div class="flex flex-col max-w-2xl">
            {activities.length === 0 && (
              <p class="text-base" style="color: var(--muted);">No activities recorded yet.</p>
            )}
            {activities.map((act, i) => (
              <div class="card flex gap-5" data-reveal style={`transition-delay: ${i * 70}ms`}>
                <span class="row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex flex-col gap-3 min-w-0 flex-1">
                  <span class="section-label">{act.data.date}</span>
                  <h4 class="card-title">{act.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{act.data.summary}</p>
                  {act.data.images && act.data.images.length > 0 && (
                    <div class="activity-photos" data-gallery>
                      {act.data.images.map((src, j) => (
                        <button
                          type="button"
                          class="activity-photo-btn"
                          data-photo-src={src}
                          data-photo-index={j}
                          aria-label={`Open photo ${j + 1} of ${act.data.title}`}
                        >
                          <img
                            src={src}
                            alt={act.data.title}
                            class="activity-photo"
                            loading="lazy"
                            decoding="async"
                          />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </div>

  <!-- Photo lightbox -->
  <dialog id="photo-lightbox" class="photo-lightbox" aria-label="Photo viewer">
    <button type="button" class="photo-lightbox__close" aria-label="Close" data-lightbox-close>×</button>
    <button type="button" class="photo-lightbox__nav photo-lightbox__nav--prev" aria-label="Previous photo" data-lightbox-prev>‹</button>
    <button type="button" class="photo-lightbox__nav photo-lightbox__nav--next" aria-label="Next photo" data-lightbox-next>›</button>
    <img class="photo-lightbox__img" alt="" />
    <p class="photo-lightbox__counter" aria-live="polite"></p>
  </dialog>
</BaseLayout>

<style>
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
  [data-view-panel] {
    transition: opacity 150ms ease;
  }
  [data-view-panel][hidden] {
    display: none;
  }

  /* Presentation badges */
  .presentation-badge {
    display: inline-block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    line-height: 1.4;
  }
  .presentation-badge--type {
    background-color: var(--accent);
    color: #0A0A0A;
  }
  .presentation-badge--scheduled {
    background-color: transparent;
    border: 1px solid var(--muted);
    color: var(--muted);
  }

  /* Activity photo grid */
  .activity-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .activity-photo-btn {
    display: block;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
    width: 100%;
  }
  .activity-photo-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .activity-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--border);
    background-color: var(--surface);
    transition: transform 200ms ease;
  }
  .activity-photo-btn:hover .activity-photo {
    transform: scale(1.02);
  }

  /* Certificate previews — small right-side thumbnails on certification
     cards, sized to sit within the card's height. Mixed aspect ratios
     (landscape Anthropic, portrait A4) both fit via max-height + auto width. */
  .cert-thumbs {
    flex-shrink: 0;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    max-width: 11rem;
  }
  .cert-thumb-btn {
    width: auto;
  }
  .cert-photo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    background-color: var(--surface);
    transition: transform 200ms ease;
  }
  .cert-thumb-btn:hover .cert-photo {
    transform: scale(1.03);
  }
  @media (max-width: 640px) {
    .cert-thumbs { max-width: 7.5rem; }
    .cert-photo { max-height: 6rem !important; }
  }

  /* Lightbox */
  .photo-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    /* dvh tracks mobile browser chrome (address/tool bars) so the counter and
       nav buttons stay on-screen; identical to vh on desktop. vh lines above
       remain as the older-browser fallback. */
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    margin: 0;
    border: none;
    background: rgba(0, 0, 0, 0.92);
    color: #FFFFFF;
  }
  .photo-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }
  .photo-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .photo-lightbox__img {
    max-width: 92vw;
    max-height: 88vh;
    max-height: 88dvh; /* mobile chrome-safe; == 88vh on desktop */
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  .photo-lightbox__close,
  .photo-lightbox__nav {
    position: absolute;
    background: transparent;
    border: none;
    color: #FFFFFF;
    cursor: pointer;
    padding: 0.5rem 1rem;
    line-height: 1;
    transition: opacity 150ms ease;
    opacity: 0.7;
  }
  .photo-lightbox__close:hover,
  .photo-lightbox__nav:hover,
  .photo-lightbox__close:focus-visible,
  .photo-lightbox__nav:focus-visible {
    opacity: 1;
    outline: none;
  }
  .photo-lightbox__close {
    top: 1rem;
    right: 1rem;
    font-size: 2.5rem;
  }
  .photo-lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
  }
  .photo-lightbox__nav--prev { left: 1rem; }
  .photo-lightbox__nav--next { right: 1rem; }
  .photo-lightbox__nav[hidden] { display: none; }
  .photo-lightbox__counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.1em;
    margin: 0;
  }
</style>

<script>
  // Photo lightbox — opens a fullscreen <dialog> with prev/next/close + keyboard.
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const imgEl = dialog.querySelector<HTMLImageElement>('.photo-lightbox__img')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    const counter = dialog.querySelector<HTMLParagraphElement>('.photo-lightbox__counter')!;

    let currentGallery: string[] = [];
    let currentIndex = 0;

    function render() {
      const src = currentGallery[currentIndex];
      if (!src) return;
      imgEl.src = src;
      counter.textContent = `${currentIndex + 1} / ${currentGallery.length}`;
      prevBtn.hidden = currentGallery.length <= 1;
      nextBtn.hidden = currentGallery.length <= 1;
    }

    function open(gallery: string[], index: number) {
      currentGallery = gallery;
      currentIndex = index;
      render();
      if (!dialog!.open) dialog!.showModal();
    }

    function close() {
      if (dialog!.open) dialog!.close();
      imgEl.src = '';
    }

    function step(delta: number) {
      if (currentGallery.length === 0) return;
      currentIndex = (currentIndex + delta + currentGallery.length) % currentGallery.length;
      render();
    }

    // Wire each gallery button
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.activity-photo-btn'));
      const srcs = buttons.map((b) => b.dataset.photoSrc ?? '');
      buttons.forEach((btn, i) => {
        btn.addEventListener('click', () => open(srcs, i));
      });
    });

    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(+1));
    closeBtn.addEventListener('click', close);

    // Click on backdrop (outside the image and controls) → close
    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog) close();
    });

    // Keyboard: ← → for navigation, Esc handled natively by <dialog>
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); step(+1); }
    });
  }
</script>
