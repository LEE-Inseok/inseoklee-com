---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Recognition — Inseok Lee"
  description="Awards, certifications, presentations, and activities."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Recognition</span>
      <h1 class="text-section mt-3" style="color: var(--ink);">Recognition.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Awards, certifications, conference presentations, and extracurricular activities.
      </p>
    </header>

    <div class="flex flex-col max-w-3xl">
      <a href="/recognition/awards" class="card flex flex-col gap-3 group">
        <span class="section-label">01</span>
        <h2 class="text-xl font-semibold" style="color: var(--ink);">Awards</h2>
        <p class="text-sm" style="color: var(--body);">
          Defense R&D Idea Competition · Korea University 3MT Presentation Award
        </p>
        <span class="cta-link text-sm mt-auto">View →</span>
      </a>

      <a href="/recognition/certifications" class="card flex flex-col gap-3 group">
        <span class="section-label">02</span>
        <h2 class="text-xl font-semibold" style="color: var(--ink);">Certifications</h2>
        <p class="text-sm" style="color: var(--body);">
          Anthropic certifications · Korea IT Academy 4-course completion
        </p>
        <span class="cta-link text-sm mt-auto">View →</span>
      </a>

      <a href="/recognition/presentations" class="card flex flex-col gap-3 group">
        <span class="section-label">03</span>
        <h2 class="text-xl font-semibold" style="color: var(--ink);">Presentations</h2>
        <p class="text-sm" style="color: var(--body);">
          Conference and seminar presentations — slides and photos.
        </p>
        <span class="cta-link text-sm mt-auto">View →</span>
      </a>

      <a href="/recognition/activities" class="card flex flex-col gap-3 group">
        <span class="section-label">04</span>
        <h2 class="text-xl font-semibold" style="color: var(--ink);">Activities</h2>
        <p class="text-sm" style="color: var(--body);">
          Sunset Marathon 2026 Half · 02:06:46
        </p>
        <span class="cta-link text-sm mt-auto">View →</span>
      </a>
    </div>
  </div>
</BaseLayout>
