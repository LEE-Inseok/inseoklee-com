---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Helix hero cards — generated from content collections, so new content
// (certifications, publications, dev projects) automatically joins the spiral.
const certs = await getCollection('recognition-certifications');
const pubs = await getCollection('publications');
const devs = await getCollection('development');

type HelixItem = { t: string; href: string };
type HelixCard =
  | { kind: 'photo'; img: string; alt: string; href: string }
  | { kind: 'text'; tag: string; label: string; href: string; items: HelixItem[] }
  | { kind: 'head'; label: string; href: string; color: string; count: number };

// ── Triple helix: each strand tells ONE story ────────────────────
// Strand 0 (cyan)  = Research   — experiments, simulation, publications
// Strand 1 (white) = Code       — development projects & tools
// Strand 2 (gray)  = Recognition — certifications, awards, activities
// Colors must match STRAND_COLORS in the script below.

// Research is one collection now; the `section` field splits it into areas.
const awards = await getCollection('recognition-awards');
const presentations = await getCollection('recognition-presentations');
const activities = await getCollection('recognition-activities');

// Small "N items" kicker — kept as data-tag for the descent detail panel.
const n = (arr: unknown[]) => `${arr.length} item${arr.length === 1 ? '' : 's'}`;

// ── Sub-content links shown in the descent's right-side detail panel ──
// {title, href} pairs pulled from the full collections (coming-soon included),
// sorted the same way the category pages sort them. Items with their own
// detail page link straight to it; list-only categories link to their panel.
type Sortable = { data: { status?: string; date?: string } };
const statusOrder: Record<string, number> = { 'published': 0, 'draft': 1, 'coming-soon': 2 };
const byStatusDate = (a: Sortable, b: Sortable) =>
  (statusOrder[a.data.status ?? ''] ?? 9) - (statusOrder[b.data.status ?? ''] ?? 9) ||
  (a.data.date ?? '').localeCompare(b.data.date ?? '');

const researchEvery = await getCollection('research');
const secItems = (section: string): HelixItem[] =>
  researchEvery
    .filter((r) => r.data.section === section)
    .sort(byStatusDate)
    .map((r) => ({ t: r.data.title, href: `/research/${r.slug}` }));
const sysItems = secItems('system-engineering');
const simItems = secItems('simulation');
const aldItems = secItems('ald');

const pubOrder: Record<string, number> = { 'published': 0, 'under-review': 1, 'submitted': 2, 'draft': 3, 'in-preparation': 4 };
const pubItems: HelixItem[] = [...pubs]
  .sort((a, b) => (pubOrder[a.data.status] ?? 9) - (pubOrder[b.data.status] ?? 9))
  .map((p) => ({ t: p.data.title, href: '/research#publications' }));
const devItems: HelixItem[] = [...devs]
  .sort(byStatusDate)
  .map((d) => ({ t: d.data.title, href: d.data.externalUrl ?? `/development/${d.slug}` }));
// Certifications grouped by issuer — two lines, not seven.
const certItems: HelixItem[] = [
  { t: 'Anthropic Academy', href: '/recognition#certifications' },
  { t: 'Korea IT Academy',  href: '/recognition#certifications' },
];
const awardItems: HelixItem[] = [...awards]
  .sort((a, b) => b.data.year - a.data.year)
  .map((a2) => ({ t: a2.data.title, href: '/recognition#awards' }));
// Presentations list the venue (conference) — paper titles are far too long for one line.
const presItems: HelixItem[] = [...presentations]
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map((p) => ({ t: p.data.conference, href: '/recognition#presentations' }));
const activityItems: HelixItem[] = activities.map((a2) => ({ t: a2.data.title, href: '/recognition#activities' }));

// ── Home spiral = a CATEGORY navigator. Each strand shows its sub-categories;
//    clicking a card jumps to that category (the items themselves live there).
const strandResearch: HelixCard[] = [
  { kind: 'photo', img: '/images/home/01-researcher.png', alt: 'Research', href: '/research' },
  { kind: 'text', tag: n(sysItems), label: 'System Engineering',        href: '/research#system-engineering', items: sysItems },
  { kind: 'text', tag: n(simItems), label: 'Simulation & Optimization', href: '/research#simulation',         items: simItems },
  { kind: 'text', tag: n(aldItems), label: 'ALD',                       href: '/research#ald',                items: aldItems },
  { kind: 'text', tag: n(pubItems), label: 'Publications',              href: '/research#publications',       items: pubItems },
];

// AI Engineering strand = its two sub-categories.
const strandCode: HelixCard[] = [
  { kind: 'photo', img: '/images/home/03-developer.png', alt: 'AI Engineering', href: '/development' },
  { kind: 'text', tag: 'Capability', label: 'AI Agent Engineering', href: '/development#agent',    items: [{ t: 'What I Built', href: '/development#agent' }, { t: 'How I run', href: '/development#agent' }] },
  { kind: 'text', tag: n(devItems),  label: 'Projects',             href: '/development#projects', items: devItems },
];

// Achievements strand = its categories (Publications is cross-listed here too).
const strandRecognition: HelixCard[] = [
  { kind: 'photo', img: '/recognition/marathon/photo-certificate.jpg', alt: 'Achievements', href: '/recognition' },
  { kind: 'text', tag: n(pubItems),      label: 'Publications',   href: '/research#publications',      items: pubItems },
  { kind: 'text', tag: n(awardItems),    label: 'Awards',         href: '/recognition#awards',         items: awardItems },
  { kind: 'text', tag: n(certs),         label: 'Certifications', href: '/recognition#certifications', items: certItems },
  { kind: 'text', tag: n(presItems),     label: 'Presentations',  href: '/recognition#presentations',  items: presItems },
  { kind: 'text', tag: n(activityItems), label: 'Activities',     href: '/recognition#activities',     items: activityItems },
];

// Level 0 of each strand is a category header card; content follows below.
// Shorter strands pad with blank placeholder cards — they fill automatically
// as new markdown files land in the collections.
// Header labels rest at silver/white and bloom to their section accent as the
// strand swings to front-center (Research=cyan, Code=pink, Recognition=green).
// SSR paints silver first; JS recolors the centered strand on load.
const STRAND_HEX = ['#FFFFFF', '#FFFFFF', '#FFFFFF'];
const strandDefs = [
  { label: 'Research', href: '/research', cards: strandResearch },
  { label: 'AI Engineering', href: '/development', cards: strandCode },
  { label: 'Achievements', href: '/recognition', cards: strandRecognition },
];

type Slot = HelixCard | { kind: 'blank' };
const STRANDS = 3;
const levels = 1 + Math.max(...strandDefs.map((s) => s.cards.length));
const slotItems: { card: Slot; level: number; strand: number }[] = [];
strandDefs.forEach((def, strand) => {
  slotItems.push({
    card: { kind: 'head', label: def.label, href: def.href, color: STRAND_HEX[strand], count: def.cards.length },
    level: 0,
    strand,
  });
  for (let k = 1; k < levels; k++) {
    slotItems.push({ card: def.cards[k - 1] ?? { kind: 'blank' }, level: k, strand });
  }
});

// Scroll runway — hero → keyword carousel → spiral descent. Tuned so every card
// gets a short, EQUAL dwell at center before advancing (see HOLD in render).
const runwayVh = 480;
---

<BaseLayout
  title="Inseok Lee — Systems · Simulation · AI · ALD"
  description="Process systems engineer — hands-on system engineering, thermal simulation, AI-driven engineering tools, and ALD processes."
>
  <!-- ============================================================
       Helix home — the entire page is one scroll-driven spiral.
       The runway height scales with content; the viewport is sticky.
       Scroll progress (0 → 1) rotates every asset around the headline.
       ============================================================ -->
  <section id="helix-hero" class="relative" style={`height: ${runwayVh}vh; background: linear-gradient(180deg, #0A0A0A 0%, #0D1117 100%);`}>
    <div
      id="helix-stage"
      class="sticky top-0 h-screen overflow-hidden flex items-center justify-center"
      style="perspective: 1200px; padding-top: var(--nav-h); cursor: grab; touch-action: pan-y pinch-zoom;"
    >
      <!-- Strand backbones — SVG lines connecting consecutive cards per strand -->
      <svg id="helix-links" class="absolute inset-0 w-full h-full" aria-hidden="true"></svg>

      <!-- Triple-helix cards -->
      <div id="helix-ring" class="absolute left-1/2 top-1/2" style="transform-style: preserve-3d;" data-levels={levels} aria-hidden="true">
        {slotItems.map(({ card, level, strand }) =>
          card.kind === 'head' ? (
            <a
              href={card.href}
              tabindex="-1"
              data-level={level}
              data-strand={strand}
              class="helix-card helix-head absolute flex flex-col items-center justify-center"
              style="width: 340px; height: 210px; left: -170px; top: -105px;"
            >
              <span class="helix-head__count">{card.count} items ↓</span>
              <span class="helix-head__label" style={`color: ${card.color};`}>{card.label}</span>
            </a>
          ) : card.kind === 'photo' ? (
            <a
              href={card.href}
              tabindex="-1"
              data-level={level}
              data-strand={strand}
              data-title={card.alt}
              class="helix-card absolute block overflow-hidden"
              style="width: 216px; height: 288px; left: -108px; top: -144px; border: 1px solid var(--border); background: var(--surface);"
            >
              <img src={encodeURI(card.img)} alt={card.alt} class="w-full h-full object-cover" loading="eager" decoding="async" />
            </a>
          ) : card.kind === 'text' ? (
            <a
              href={card.href}
              tabindex="-1"
              data-level={level}
              data-strand={strand}
              data-tag={card.tag}
              data-title={card.label}
              data-items={JSON.stringify(card.items)}
              class="helix-card absolute flex flex-col justify-between p-5"
              style="width: 288px; height: 168px; left: -144px; top: -84px; background: var(--surface); border: 1px solid var(--border);"
            >
              <span class="section-label">{card.tag}</span>
              <span class="leading-snug" style="color: var(--ink); font-weight: 600; font-size: 1.05rem;">{card.label}</span>
            </a>
          ) : (
            <div
              data-level={level}
              data-strand={strand}
              class="helix-card absolute"
              style="width: 216px; height: 288px; left: -108px; top: -144px; border: 1px dashed var(--border); background: rgba(22, 22, 22, 0.6);"
            />
          )
        )}

        <!-- Manual reflection of the single focused card — mirrored + skewed
             toward the lower-left, driven by JS (see render()). -->
        <div id="helix-reflect" class="helix-card" style="opacity: 0; visibility: hidden; pointer-events: none;" aria-hidden="true"></div>
      </div>

      <!-- Center headline (line-reveal on load, fades away as you descend) -->
      <div id="helix-title" class="relative z-10 text-center pointer-events-none px-6">
        <h1 class="hero-line text-6xl lg:text-9xl font-bold leading-none" style="color: var(--ink);">
          <span class="hero-line__inner">Hi, I'm Inseok.</span>
        </h1>
        <p class="hero-line mt-6 text-lg lg:text-2xl" style="color: var(--muted);">
          <span class="hero-line__inner">System Engineering · Simulation &amp; Optimization · ALD <span style="color: var(--accent); font-weight: 600; white-space: nowrap;">× AI</span></span>
        </p>
        <p id="helix-hint" class="hero-line mt-12 text-xs uppercase tracking-widest" style="color: var(--muted);">
          <span class="hero-line__inner">Drag to rotate · Scroll ↓</span>
        </p>
      </div>

      <!-- Carousel arrows — sleek arrowhead darts flanking the Act 2 keyword
           ring. Click rotates one keyword step; drag/tap rotation is untouched.
           Opacity + interactivity are driven from render(). -->
      <button id="helix-arrow-prev" class="helix-arrow helix-arrow--prev" type="button" aria-label="Previous keyword">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 3 L6 12 L17 21 L13.4 12 Z" /></svg>
      </button>
      <button id="helix-arrow-next" class="helix-arrow helix-arrow--next" type="button" aria-label="Next keyword">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 3 L18 12 L7 21 L10.6 12 Z" /></svg>
      </button>

      <!-- Active strand indicator -->
      <div
        id="helix-active"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2 text-xs uppercase tracking-widest pointer-events-none transition-opacity duration-300"
        style="color: var(--muted); opacity: 0;"
      >
        <span id="helix-active-dot" style="width: 8px; height: 8px; background: #22D3EE; display: inline-block;"></span>
        <span id="helix-active-label">Research</span>
      </div>

      <!-- Right-side detail for the focused card (paired with the left card).
           The big title links to the category; each sub-content line links
           straight to its project. Pointer events are toggled by JS so the
           links are only clickable while the panel is visible. -->
      <div id="helix-detail" class="absolute z-10 pointer-events-none">
        <span id="helix-detail-tag" class="section-label"></span>
        <h2 id="helix-detail-title"><a id="helix-detail-title-link" href="#"></a></h2>
        <ul id="helix-detail-items"></ul>
      </div>
    </div>
  </section>

</BaseLayout>

<!--
  Helix home styles — shipped only on the / render, never leaks to other pages.
-->
<style is:global>
  html {
    /* free scrolling for the helix runway */
    scroll-behavior: auto;
  }

  /* Hero line-reveal — each line rides up from behind an overflow mask.
     JS adds .is-in one frame after load to trigger the staggered reveal. */
  .hero-line { overflow: hidden; }
  .hero-line__inner {
    display: block;
    transform: translateY(115%);
    transition: transform var(--dur-hero) var(--ease-expo);
    will-change: transform;
  }
  #helix-title.is-in .hero-line__inner { transform: translateY(0); }
  #helix-title.is-in .hero-line:nth-child(1) .hero-line__inner { transition-delay: 60ms; }
  #helix-title.is-in .hero-line:nth-child(2) .hero-line__inner { transition-delay: 180ms; }
  #helix-title.is-in .hero-line:nth-child(3) .hero-line__inner { transition-delay: 320ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-line__inner { transform: none !important; transition: none !important; }
  }

  /* Strand header — big typographic label with a mirrored reflection below.
     No box/border: the type itself is the object. Color is driven by JS
     (silver at rest → section accent when it swings to front-center). */
  .helix-head__count {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }
  .helix-head__label {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 4.8rem;
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    -webkit-box-reflect: below 0.12em
      linear-gradient(to bottom, transparent 42%, rgba(255, 255, 255, 0.32));
  }

  /* Manual reflection of the focused card: flipped + skewed toward the
     lower-left, faded with a mask so it reads clearly as a reflection. */
  #helix-reflect {
    /* Element is flipped with scaleY(-1); the mask runs "to top" in local
       space so the reflection is strongest next to the card and fades away. */
    -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.65), rgba(0,0,0,0) 70%);
    mask-image: linear-gradient(to top, rgba(0,0,0,0.65), rgba(0,0,0,0) 70%);
  }

  /* Description paired with the focused card. The spiral is offset to the LEFT
     during the descent, so the card sits at left-center and this text lives in
     the right half — vertically centered, no overlap. */
  #helix-detail {
    left: 57%;
    top: 50%;
    transform: translateY(-50%);
    max-width: 37%;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-expo);
  }
  #helix-detail-title {
    font-family: 'Fraunces', Georgia, serif;
    color: var(--ink);
    font-size: clamp(1.5rem, 2.3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-top: 0.5rem;
  }

  /* The big detail title is a link to its category — inverts on hover like
     the content cards do. */
  #helix-detail-title a {
    color: inherit;
    text-decoration: none;
    padding: 0 0.12em;
    margin: 0 -0.12em;
    transition: background-color 120ms ease, color 120ms ease;
  }
  #helix-detail-title a:hover {
    background: #F5F5F5;
    color: #0A0A0A;
  }

  /* Sub-content links under the detail title — dash-labelled lines, one per
     project; hovering inverts the line and clicking jumps straight to it.
     Long lists show the first 4 plus a "+N more" line (filled by JS). */
  #helix-detail-items {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  #helix-detail-items a {
    display: block;
    max-width: 100%;
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 0.5rem;
    margin: 0 -0.5rem;
    transition: background-color 120ms ease, color 120ms ease;
  }
  #helix-detail-items a::before {
    content: '–  ';
    white-space: pre;
  }
  #helix-detail-items a:hover {
    background: #F5F5F5;
    color: #0A0A0A;
  }
  #helix-detail-items li.helix-detail__more a {
    opacity: 0.75;
  }

  /* Carousel arrows — filled arrowhead darts (notched triangles) either side
     of the keyword ring. Hidden until Act 2; JS drives opacity/interactivity. */
  .helix-arrow {
    position: absolute;
    top: 50%;
    z-index: 20;
    width: 56px;
    height: 72px;
    margin-top: -36px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: color 160ms ease, transform 160ms ease;
  }
  .helix-arrow svg { width: 28px; height: 28px; display: block; }
  .helix-arrow--prev { left: clamp(10px, 4.5vw, 88px); }
  .helix-arrow--next { right: clamp(10px, 4.5vw, 88px); }
  .helix-arrow:hover,
  .helix-arrow:focus-visible { color: var(--ink); }
  .helix-arrow--prev:hover { transform: translateX(-3px); }
  .helix-arrow--next:hover { transform: translateX(3px); }
  .helix-arrow:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 700px) {
    .helix-arrow { width: 44px; height: 60px; margin-top: -30px; }
    .helix-arrow svg { width: 22px; height: 22px; }
  }

  /* Helix card rendering hints */
  .helix-card {
    backface-visibility: hidden;
    will-change: transform, opacity;
    pointer-events: auto;
    user-select: none;
  }
  .helix-card img {
    -webkit-user-drag: none;
    user-select: none;
  }
  #helix-stage.is-dragging {
    cursor: grabbing;
  }

  /* Reduced motion: collapse the scroll runway, show a calm static composition */
  @media (prefers-reduced-motion: reduce) {
    #helix-hero { height: 100vh !important; min-height: 100vh; }
  }

  /* Mobile keeps the SAME desktop composition (card left · description right),
     just scaled down in JS (uiScale). Keyword type stays the desktop size and
     is shrunk by the card transform, so we don't override its font here. The
     description stays on the right; we only give it a touch more width and a
     smaller title so it reads on a narrow screen. */
  @media (max-width: 700px) {
    .helix-head__count { font-size: 0.6rem; margin-bottom: 0.4rem; }
    /* Portrait: the card is centered, so the description sits BELOW it.
       bottom compensates for mobile browser chrome: (100vh - 100dvh) equals
       the visible chrome height, 0 on desktop and when the bar is collapsed. */
    #helix-detail {
      left: 50%;
      right: auto;
      top: auto;
      bottom: calc(11% + (100vh - 100dvh));
      transform: translateX(-50%);
      max-width: 86%;
      text-align: center;
    }
    #helix-detail-title { font-size: clamp(1.05rem, 4vw, 1.5rem); margin-top: 0.35rem; }
    /* Keep the strand indicator above mobile browser chrome too. */
    #helix-active {
      bottom: calc(2rem + (100vh - 100dvh));
    }
    /* Cards render at ~0.5 scale on phones — bump in-card type so the focused
       card stays legible (roughly cancels the shrink). !important beats the
       inline font-size on the label span. */
    .helix-card span.leading-snug { font-size: 1.5rem !important; }
    .helix-card .section-label { font-size: 0.95rem; }
    #helix-detail-items { margin-top: 0.5rem; }
    #helix-detail-items a { font-size: 0.8rem; line-height: 1.7; }
  }

</style>

<script>
  // Scroll-driven TRIPLE helix: three strands offset 120° share one tall
  // spiral column. Scrolling moves the camera DOWN the column — cards above
  // rise out of view, cards below wind up from underneath on all 3 strands.
  const wrap = document.getElementById('helix-hero');
  const ring = document.getElementById('helix-ring');
  const hint = document.getElementById('helix-hint');
  const title = document.getElementById('helix-title');
  const svg = document.getElementById('helix-links');
  const reflectEl = document.getElementById('helix-reflect') as HTMLElement | null;
  const cards = ring
    ? (Array.from(ring.children).filter((el) => el.id !== 'helix-reflect') as HTMLElement[])
    : [];
  const levels = ring ? Number(ring.dataset.levels) || 1 : 1;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = window.matchMedia('(pointer: coarse)').matches; // touch device

  const stage = document.getElementById('helix-stage');
  const activeBox = document.getElementById('helix-active');
  const activeDot = document.getElementById('helix-active-dot');
  const activeLabel = document.getElementById('helix-active-label');
  const detailBox = document.getElementById('helix-detail');
  const detailTag = document.getElementById('helix-detail-tag');
  const detailTitleLink = document.getElementById('helix-detail-title-link') as HTMLAnchorElement | null;
  const detailItems = document.getElementById('helix-detail-items');
  const arrowPrev = document.getElementById('helix-arrow-prev');
  const arrowNext = document.getElementById('helix-arrow-next');

  const STRAND_OFFSET = (Math.PI * 2) / 3; // 120° between strands
  const STRAND_LABELS = ['Research', 'AI Engineering', 'Achievements'];
  const stepAngle = Math.PI / 5; // twist per level as the column descends
  const PERSP = 1200; // must match the container's CSS perspective
  const TWO_PI = Math.PI * 2;
  let radius = 320;
  let stepY = 380; // vertical drop between consecutive levels (wide gaps: a
                   // card fully fades before the next arrives at center)
  // Global card scale so narrow (mobile) screens render the SAME desktop
  // composition — card on the left, description on the right — just zoomed out,
  // instead of a different mobile layout. 1 on desktop, shrinks on small widths.
  let uiScale = 1;

  // ── Three-act choreography boundaries (shared by render + snap geometry) ──
  //   Act 1 hero  · Act 2 keyword carousel (held) · Act 3 spiral descent
  const HERO_OUT = 0.08; // headline gone / keywords fade in
  const KW_IN = 0.14;    // keyword carousel fully present
  const KW_OUT = 0.28;   // camera starts descending into the content
  const smooth01 = (v: number) => { const s = Math.min(1, Math.max(0, v)); return s * s * (3 - 2 * s); };
  // Act 3 progress: 0 while the carousel is held, 0→1 through the descent.
  const spiralProg = (p: number) => Math.min(1, Math.max(0, (p - KW_OUT) / (1 - KW_OUT)));
  // Camera depth down the column. Sits at 0 during the carousel (headers at
  // eye level, on the ring), then descends level-by-level through Act 3.
  const cameraAt = (sp: number) => sp * (levels + 0.5);

  // ── Drag-to-rotate & strand selection ──────────────────────────
  // `spin` is a user-controlled rotation added to every card's angle.
  // The strand whose header card sits closest to the front is "active":
  // it renders at full strength, the other two recede into the background.
  let spin = 0; // start with the Research keyword facing front-center
  let activeStrand = 0;
  let lastP = 0;

  function normAngle(a: number) {
    return ((a % TWO_PI) + TWO_PI + Math.PI) % TWO_PI - Math.PI; // → [-π, π)
  }

  // On-screen ring angle of a strand's header card at scroll position p.
  // Mirrors render()'s geometry (camera = cameraAt(spiralProg)), so angle 0 ===
  // front-center. Selection/snapping happens while the carousel is held
  // (spiralProg 0 → camera 0 → header at eye level), where this is exact.
  function headerAngle(s: number, sp: number, p: number) {
    const camera = cameraAt(spiralProg(p));
    const d = 0 - camera; // header sits at level 0
    return d * stepAngle + s * STRAND_OFFSET + sp;
  }

  function computeActive() {
    let best = 0;
    let bestAbs = Infinity;
    for (let s = 0; s < 3; s++) {
      const abs = Math.abs(normAngle(headerAngle(s, spin, lastP)));
      if (abs < bestAbs) { bestAbs = abs; best = s; }
    }
    if (best !== activeStrand) {
      activeStrand = best;
      if (activeLabel) activeLabel.textContent = STRAND_LABELS[best];
    }
  }

  // Strand colors are IDENTITY-based: each strand permanently owns its section
  // accent. Research=cyan, Code=pink, Recognition=green. Whichever strand is at
  // the front blooms to full color; the others dim toward their OWN dark hue
  // (keeping their identity legible) rather than collapsing to gray.
  const STRAND_RGB = [
    [18, 173, 199],   // Research    #12ADC7 (cyan)
    [219, 79, 148],   // Code        #DB4F94 (pink)
    [46, 169, 106],   // Recognition #2EA96A (green)
  ];
  // Dimmed companion — same hue, darkened (used for the backbone lines).
  const STRAND_DIM = STRAND_RGB.map((c) => c.map((v) => Math.round(v * 0.42 + 10)));
  // Header labels rest at silver/white and bloom to their accent at front.
  const SILVER = [214, 216, 222];
  const rgbStr = (c: number[]) => `rgb(${c[0]}, ${c[1]}, ${c[2]})`;

  // Strand backbones: one polyline segment between consecutive cards of the
  // same strand, drawn in screen space using the same perspective projection.
  type Seg = { el: SVGLineElement; strand: number; level: number };
  const segs: Seg[] = [];
  if (svg) {
    const NS = 'http://www.w3.org/2000/svg';
    for (let s = 0; s < 3; s++) {
      // Start at k=1: skip the header→first-card segment (it would run behind
      // the big header text and read as a stray line).
      for (let k = 1; k < levels - 1; k++) {
        const line = document.createElementNS(NS, 'line') as SVGLineElement;
        line.setAttribute('stroke', rgbStr(STRAND_DIM[s]));
        line.setAttribute('stroke-width', '1.5');
        line.setAttribute('stroke-linecap', 'round');
        svg.appendChild(line);
        segs.push({ el: line, strand: s, level: k });
      }
    }
  }

  // Header cards (level 0) per strand — recolored when the active strand changes
  const headerEls: (HTMLElement | undefined)[] = [];
  for (const el of cards) {
    if (el.dataset.level === '0') headerEls[Number(el.dataset.strand)] = el;
  }

  // Deepest level that actually holds a card (has a title) per strand — the
  // descent stops here so a short strand doesn't scroll through empty padding.
  const strandMaxLevel = [0, 0, 0];
  for (const el of cards) {
    if (!el.dataset.title) continue; // skip headers + blank placeholders
    const s = Number(el.dataset.strand);
    const lv = Number(el.dataset.level);
    if (lv > strandMaxLevel[s]) strandMaxLevel[s] = lv;
  }

  // Continuous intensity blend: a strand blooms to its full identity color as
  // its header card nears front-center. Full within ~20° of front, resting
  // beyond ~57°. Header labels rest at SILVER; backbone lines rest at dim hue.
  const ZONE_IN = 0.35;  // rad — inside this: 100% full color
  const ZONE_OUT = 1.0;  // rad — beyond this: 100% resting

  // Blend two RGB triples by weight w∈[0,1].
  function mix(a: number[], b: number[], w: number) {
    const r = Math.round(a[0] + (b[0] - a[0]) * w);
    const g = Math.round(a[1] + (b[1] - a[1]) * w);
    const bl = Math.round(a[2] + (b[2] - a[2]) * w);
    return `rgb(${r}, ${g}, ${bl})`;
  }

  function updateStrandColors() {
    for (let s = 0; s < 3; s++) {
      const a = Math.abs(normAngle(headerAngle(s, spin, lastP)));
      let w = a <= ZONE_IN ? 1 : a >= ZONE_OUT ? 0 : 1 - (a - ZONE_IN) / (ZONE_OUT - ZONE_IN);
      w = w * w * (3 - 2 * w); // smoothstep — soft landing at both ends
      // NOTE: header label color is driven inside render() (accent on the
      // Act 2 title screen, cooling to silver as the word joins the helix),
      // so it is intentionally NOT set here.
      // Descending stem for this strand carries the accent: dim hue → full
      // accent as the strand swings to front-center.
      for (const seg of segs) {
        if (seg.strand === s) seg.el.setAttribute('stroke', mix(STRAND_DIM[s], STRAND_RGB[s], w));
      }
    }
    // Bottom indicator dot mirrors the active strand's full identity color.
    if (activeDot) activeDot.style.background = rgbStr(STRAND_RGB[activeStrand]);
  }

  function measure() {
    // Proportional zoom: at/above ~760px this is 1 (full desktop); below it the
    // whole composition scales down so phones show the SAME layout, smaller.
    uiScale = Math.min(1, Math.max(0.5, window.innerWidth / 760));
    radius = Math.min(400, Math.max(180, window.innerWidth * 0.3));
    // Wide vertical gap between levels so each content card fully fades out
    // before the next climbs into center — tightened a little on small screens.
    stepY = Math.max(300, window.innerHeight * 0.52) * (0.6 + 0.4 * uiScale);
    if (svg) svg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`);
  }

  // Where active-strand cards cross eye level once the descent is underway:
  // pinned to the LEFT so the focused card sits left and its detail text can
  // live on the right half.
  const THETA_LEFT = -0.62; // rad → x ≈ -0.58 × radius (left of center, paired with right text)
  function descentRamp(p: number) {
    // 0 at the top (header snaps dead-center), eases to 1 by ~15% scroll
    const t = Math.min(1, Math.max(0, (p - 0.03) / 0.12));
    return t * t * (3 - 2 * t);
  }

  // Drives the two extras tied to the single focused card:
  //   1) the right-side detail text (tag + title)
  //   2) the manual mirrored reflection (flipped + skewed to the lower-left)
  function updateFocusExtras(
    focus: { el: HTMLElement; x: number; y: number; z: number; scl: number; h: number } | null,
    intro: number,
    descending: boolean,
  ) {
    const on = !!focus && descending && intro > 0.02;
    const stack = window.innerWidth <= 700; // mobile: photo on top, text below
    // "Settle" = how centered the focused card is vertically (1 at eye level).
    // The text + reflection fade in only once the card has arrived, not while
    // it is still sliding up into place.
    let settle = 0;
    if (focus) {
      const s = Math.max(0, 1 - Math.abs(focus.y) / (window.innerHeight * 0.24));
      settle = s * s * (3 - 2 * s);
    }

    if (detailBox) {
      if (on && focus) {
        if (detailTag) {
          detailTag.textContent = focus.el.dataset.tag || '';
          detailTag.style.color = rgbStr(STRAND_RGB[activeStrand]);
        }
        const catHref = focus.el.getAttribute('href') || '#';
        if (detailTitleLink) {
          detailTitleLink.textContent = focus.el.dataset.title || '';
          detailTitleLink.href = catHref;
        }
        // Sub-content links under the category title — rebuilt only when the
        // focused card changes (first 4 + "+N more" beyond five).
        if (detailItems) {
          const key = `${focus.el.dataset.strand}-${focus.el.dataset.level}`;
          if (detailItems.dataset.key !== key) {
            detailItems.dataset.key = key;
            detailItems.textContent = '';
            let entries: { t: string; href: string }[] = [];
            try { entries = JSON.parse(focus.el.dataset.items || '[]'); } catch {}
            const shown = entries.length > 5 ? entries.slice(0, 4) : entries;
            const addLine = (text: string, href: string, cls?: string) => {
              const li = document.createElement('li');
              if (cls) li.className = cls;
              const a = document.createElement('a');
              a.href = href;
              a.textContent = text;
              if (/^https?:/.test(href)) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
              li.appendChild(a);
              detailItems.appendChild(li);
            };
            for (const it of shown) addLine(it.t, it.href);
            if (entries.length > 5) addLine(`+${entries.length - 4} more`, catHref, 'helix-detail__more');
          }
        }
        // Mobile: pin the text directly BELOW the centered card so the pair
        // reads as one centered group. Desktop keeps the CSS placement.
        if (stack && focus) {
          const cardBottom = window.innerHeight / 2 + focus.y + (focus.h / 2) * focus.scl;
          detailBox.style.top = `${(cardBottom + 16).toFixed(1)}px`;
          detailBox.style.bottom = 'auto';
        } else {
          detailBox.style.top = '';
          detailBox.style.bottom = '';
        }
        const op = Math.min(1, intro * settle);
        detailBox.style.opacity = String(op);
        // Links are real now — clickable only while the panel is visible.
        detailBox.style.pointerEvents = op > 0.25 ? 'auto' : 'none';
      } else {
        detailBox.style.opacity = '0';
        detailBox.style.pointerEvents = 'none';
      }
    }

    if (reflectEl) {
      // No mirror on the stacked mobile layout — the detail text sits where
      // the reflection would render.
      if (on && focus && !stack) {
        const key = `${focus.el.dataset.strand}-${focus.el.dataset.level}`;
        if (reflectEl.dataset.key !== key) {
          reflectEl.dataset.key = key;
          reflectEl.innerHTML = focus.el.innerHTML;
          reflectEl.style.width = focus.el.style.width;
          reflectEl.style.height = focus.el.style.height;
          reflectEl.style.left = focus.el.style.left;
          reflectEl.style.top = focus.el.style.top;
          reflectEl.className = `${focus.el.className} helix-card`; // match card look
        }
        const yR = focus.y + focus.h * focus.scl; // butt the reflection to the card's bottom
        // Straight-down mirror (no skew) so every reflection on the page reads
        // the same way as the keyword box-reflects.
        reflectEl.style.transform =
          `translate3d(${focus.x.toFixed(1)}px, ${yR.toFixed(1)}px, ${focus.z.toFixed(1)}px)` +
          ` scale(${focus.scl.toFixed(3)}) scaleY(-1)`;
        reflectEl.style.opacity = (0.5 * intro * settle).toFixed(3);
        reflectEl.style.visibility = 'visible';
        reflectEl.style.zIndex = '6';
      } else {
        reflectEl.style.opacity = '0';
        reflectEl.style.visibility = 'hidden';
        reflectEl.dataset.key = '';
      }
    }
  }

  function render(p: number) {
    // ── Three-act choreography ─────────────────────────────────────
    //   Act 1 · hero       "Hi, I'm Inseok." alone
    //   Act 2 · keywords   Research / Code / Recognition on a horizontal ring —
    //                      DRAG to rotate/select, nearest snaps to front-center
    //   Act 3 · descent    Selected keyword slides to LEFT-center and holds for
    //                      ~one screen, then its content cards wind DOWN the
    //                      spiral, each dwelling at left-center (description text
    //                      to the right) before the next takes its place.
    const kwIn = smooth01((p - HERO_OUT) / (KW_IN - HERO_OUT));   // 0→1 keyword fade-in
    const spiralP = spiralProg(p);                               // Act 3 progress
    // Shift-to-left + tighten: completes fast so the keyword snaps to the left
    // and everything after it lives in the left column.
    const shiftT = smooth01(Math.min(1, spiralP / 0.04));

    // Act 3 opens with a short hold: the selected keyword slides to left-center
    // and lingers briefly (spiralP 0 → KHOLD), then the camera descends.
    const KHOLD = 0.11;
    const descP = Math.max(0, (spiralP - KHOLD) / (1 - KHOLD)); // 0 during hold, 0→1 through descent
    const contentGate = smooth01(Math.min(1, descP / 0.03));    // content fades in as the descent begins
    const descending = spiralP > 0.004;

    // Camera advances one card at a time with a UNIFORM rhythm: every card holds
    // dead-center (perfectly still + aligned) for HOLD of its scroll cell, then
    // eases to the next over the rest. Identical scroll distance for every card,
    // all the way down. The descent spans only the active strand's real cards,
    // and the last card arrives a touch early so it gets a full dwell too.
    const lastLevel = Math.max(1, strandMaxLevel[activeStrand]);
    const arrive = 0.9; // whole strand centered by 90% of the descent, then last card holds
    const rawP = Math.min(1, descP / arrive);
    const raw = rawP * lastLevel;
    const kBase = Math.min(lastLevel - 1, Math.floor(raw));
    const frac = raw - kBase;
    const HOLD = 0.5; // fraction of each card's cell spent perfectly centered (the dwell)
    const moveRaw = frac <= HOLD ? 0 : (frac - HOLD) / (1 - HOLD);
    const camera = kBase + smooth01(moveRaw);

    const fadeDist = window.innerHeight * 0.9;
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    // Desktop: the spiral axis slides left so the right half is free for the
    // description. Mobile (portrait): keep it centered — the description sits
    // BELOW the card instead, so no left-shift is needed.
    const stackLayout = window.innerWidth <= 700;
    const axisX = stackLayout ? 0 : -radius * 0.52 * shiftT;
    // Mobile: lift the spiral axis during the descent so the focused card sits
    // in the upper half and the detail text fits directly beneath it —
    // photo on top, text below, both centered as one group.
    const axisY = stackLayout ? -window.innerHeight * 0.11 * shiftT : 0;
    const rEff = radius * (1 - 0.3 * shiftT);

    let focus: { el: HTMLElement; x: number; y: number; z: number; scl: number; h: number } | null = null;
    let bestNear = 0.001; // focus = the active content card closest to center
    // pts[strand][level] = projected screen position + visibility
    const pts: { sx: number; sy: number; vis: number }[][] = [[], [], []];

    for (const el of cards) {
      const level = Number(el.dataset.level);
      const strand = Number(el.dataset.strand);
      const isHead = level === 0;
      const isActive = strand === activeStrand;
      const hasTitle = !!el.dataset.title;
      const d = level - camera; // signed distance from camera (0 = at eye level)
      const a = d * stepAngle + strand * STRAND_OFFSET + spin;
      const x = Math.sin(a) * rEff + axisX;
      const z = Math.cos(a) * rEff - radius * 0.3;
      const y = d * stepY + axisY;
      const front = (Math.cos(a) + 1) / 2; // 1 = facing the viewer

      const vis = Math.max(0, 1 - Math.abs(y) / fadeDist); // fade with vertical distance
      // Non-active strands recede once the descent has started.
      const recede = spiralP > 0.02 && !isActive ? 0.22 : 1;
      // Centeredness: 1 when a card sits exactly at eye level, 0 by one level
      // away. Drives both the enlargement and which card owns the description.
      const near = Math.max(0, 1 - Math.abs(d));
      const nearS = near * near * (3 - 2 * near);

      // Scale capped at ~1.0 (native) so rasters never upscale → no pixelation.
      let scl;
      if (recede < 1) scl = 0.56 + front * 0.10;                       // other strands, small
      else if (isActive && descending) scl = 0.6 + 0.36 * nearS + 0.04 * front; // grows AT center
      else scl = 0.78 + front * 0.20;                                   // Act 2 carousel
      scl *= uiScale; // proportional shrink on small screens (desktop = ×1)

      let op: number;
      if (isHead) {
        // Keyword header — big white type. Rides the ring in Act 2, slides to
        // left-center and holds in Act 3, then climbs out as the cards descend.
        // Only the SELECTED keyword is bright; the other two stay well dimmed so
        // they never fight the centered word even where the type overlaps.
        // Non-selected keywords stay dark on desktop (you drag past them), but
        // stay visible on mobile so they're clearly tappable.
        const headDim = isActive ? 1 : (stackLayout ? 0.5 : 0.2);
        const count = el.querySelector('.helix-head__count') as HTMLElement | null;
        if (count) count.style.opacity = ((0.4 + 0.5 * front) * headDim).toFixed(3);
        op = kwIn * vis * (0.3 + 0.7 * front) * headDim;
      } else {
        // Content cards: held behind the keyword in Act 2, then wind down the
        // spiral. The centered card is brightest; siblings stay readable.
        const dim = isActive && descending ? (0.4 + 0.6 * nearS) : 1;
        op = vis * (0.35 + 0.65 * front) * recede * contentGate * dim;
      }

      el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, ${z.toFixed(1)}px) scale(${scl.toFixed(3)})`;
      el.style.opacity = op.toFixed(3);
      const zBoost = isActive && descending ? Math.round(nearS * 9) : 0;
      el.style.zIndex = String((isHead ? 9 : isActive ? 8 : 1) + Math.round(front * 6) + zBoost);
      const hidden = isHead ? op <= 0.01 : (op <= 0.01 || contentGate <= 0.02);
      el.style.visibility = hidden ? 'hidden' : 'visible';

      // The most-centered active content card owns the right-side description.
      if (isActive && descending && hasTitle && near > bestNear) {
        bestNear = near;
        focus = { el, x, y, z, scl, h: parseFloat(el.style.height) || 168 };
      }

      // Same perspective projection the browser applies to the 3D cards
      const proj = PERSP / (PERSP - z);
      pts[strand][level] = { sx: cx + x * proj, sy: cy + y * proj, vis };
    }

    updateFocusExtras(focus, contentGate, descending);

    // Strand backbone segments — appear with the content in Act 3.
    for (const seg of segs) {
      const p1 = pts[seg.strand][seg.level];
      const p2 = pts[seg.strand][seg.level + 1];
      if (!p1 || !p2) continue;
      const recedeSeg = spiralP > 0.02 && seg.strand !== activeStrand ? 0.25 : 1;
      const o = Math.min(p1.vis, p2.vis) * 0.45 * recedeSeg * contentGate;
      if (o <= 0.02) {
        seg.el.setAttribute('stroke-opacity', '0');
        continue;
      }
      seg.el.setAttribute('x1', p1.sx.toFixed(1));
      seg.el.setAttribute('y1', p1.sy.toFixed(1));
      seg.el.setAttribute('x2', p2.sx.toFixed(1));
      seg.el.setAttribute('y2', p2.sy.toFixed(1));
      seg.el.setAttribute('stroke-opacity', o.toFixed(3));
    }

    updateStrandColors();

    if (title) {
      // Headline holds through Act 1, then clears cleanly before the keywords
      // arrive (fully gone by HERO_OUT, so the two never overlap).
      const tFade = Math.max(0, 1 - (p - 0.02) / 0.06);
      title.style.opacity = String(tFade);
      title.style.transform = `translateY(${(-40 * (1 - tFade)).toFixed(1)}px)`;
      title.style.visibility = tFade <= 0.01 ? 'hidden' : 'visible';
    }
    if (hint) hint.style.opacity = p > 0.03 ? '0' : '1';
    if (activeBox) activeBox.style.opacity = spiralP > 0.02 ? '1' : '0';

    // Carousel arrows live with the keyword ring: in through Act 2, gone the
    // moment the descent shifts the ring left (same guard as drag rotation).
    if (arrowPrev && arrowNext) {
      const aOp = kwIn * (1 - smooth01(Math.min(1, spiralP / 0.02)));
      for (const b of [arrowPrev, arrowNext]) {
        b.style.opacity = aOp.toFixed(3);
        b.style.pointerEvents = aOp > 0.35 ? 'auto' : 'none';
      }
    }
  }

  let ticking = false;
  function onScroll() {
    if (ticking || !wrap) return;
    ticking = true;
    requestAnimationFrame(() => {
      const total = wrap.offsetHeight - window.innerHeight;
      lastP = total > 0 ? Math.min(1, Math.max(0, -wrap.getBoundingClientRect().top / total)) : 0;
      render(lastP);
      ticking = false;
    });
  }

  // ── Drag to rotate, snap the nearest strand header to dead center ──
  // Whichever header sits closest to the front is pulled to angle 0 (screen
  // center). Released exactly between two boxes → the nearer one always wins.
  let snapRaf = 0;
  // Spring the rotation to an absolute target `to`, snapping the chosen header
  // to front-center. Shared by drag-release, tap-to-select, and programmatic use.
  function springSpinTo(to: number) {
    if (Math.abs(to - spin) < 0.0008) { computeActive(); render(lastP); return; }
    const from = spin;
    const t0 = performance.now();
    const DUR = 620;
    // Damped spring blended with a plain settle. TENSION scales how much of the
    // springy overshoot survives (1 = full spring, 0 = no overshoot).
    //   DAMPING lower → more / longer bounce · FREQ higher → more oscillations
    const DAMPING = 5.6;
    const FREQ = 2.35;
    const TENSION = 0.42;
    cancelAnimationFrame(snapRaf);
    function step(now: number) {
      const t = Math.min(1, (now - t0) / DUR);
      const spring = 1 - Math.exp(-DAMPING * t) * Math.cos(FREQ * Math.PI * t);
      const settle = 1 - Math.pow(1 - t, 4); // easeOutQuart, no overshoot
      const ease = t >= 1 ? 1 : settle + (spring - settle) * TENSION;
      spin = from + (to - from) * ease;
      computeActive();
      render(lastP);
      if (t < 1) snapRaf = requestAnimationFrame(step);
    }
    snapRaf = requestAnimationFrame(step);
  }
  function snapToNearest() {
    computeActive(); // refresh the nearest strand from the current spin
    springSpinTo(spin - normAngle(headerAngle(activeStrand, spin, lastP)));
  }
  // Tap a keyword (touch): rotate THAT strand to the front-center.
  function selectStrand(s: number) {
    springSpinTo(spin - normAngle(headerAngle(s, spin, lastP)));
  }
  // Arrow-click: rotate exactly one keyword step. dir +1 pulls the keyword
  // waiting on the RIGHT to front-center; -1 pulls the one on the LEFT.
  function rotateStep(dir: number) {
    computeActive();
    const centered = spin - normAngle(headerAngle(activeStrand, spin, lastP));
    springSpinTo(centered - dir * STRAND_OFFSET);
  }

  if (stage && !reduced) {
    // Tell touch users to tap (there's no cursor to "drag").
    if (coarse && hint) {
      const hintInner = hint.querySelector('.hero-line__inner');
      if (hintInner) hintInner.textContent = 'Tap a keyword · Scroll ↓';
    }
    let active = false;   // a pointer is down, direction not yet decided
    let dragging = false; // committed to a horizontal rotate
    let moved = 0;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let targetSpin = spin;
    let smoothRaf = 0;
    let smoothing = false;

    // The pointer drives targetSpin; the visible spin eases toward it every
    // frame (critically damped lerp) so rotation feels weighty, not twitchy.
    function smoothLoop() {
      const diff = targetSpin - spin;
      if (Math.abs(diff) > 0.0004) {
        spin += diff * 0.1;
        computeActive();
        render(lastP);
        smoothRaf = requestAnimationFrame(smoothLoop);
      } else {
        spin = targetSpin;
        computeActive();
        render(lastP);
        smoothing = false;
        if (!dragging) snapToNearest();
      }
    }
    function startSmoothing() {
      if (!smoothing) {
        smoothing = true;
        smoothRaf = requestAnimationFrame(smoothLoop);
      }
    }

    // Links are natively draggable — that hijacks pointer events and the
    // strand stays "grabbed". Kill native drag inside the stage entirely.
    stage.addEventListener('dragstart', (e) => e.preventDefault());

    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return; // left button / touch only
      // Rotation is allowed ONLY when the keywords are fully centered
      // (spiralProg === 0, before any left-shift). The moment you scroll into
      // the descent the selected keyword slides left; rotating from that
      // shifted state is exactly what left the ring off-center on the way back
      // up. So: no rotation until you've scrolled all the way up to center.
      if (spiralProg(lastP) > 0.0005) return;
      active = true;
      dragging = false;
      moved = 0;
      startX = lastX = e.clientX;
      startY = e.clientY;
      cancelAnimationFrame(snapRaf);
      targetSpin = spin;
      // NB: don't capture or mark dragging yet — first see if the gesture is
      // horizontal (rotate) or vertical (let the page scroll). This is what
      // stops a vertical touch-scroll from spinning the carousel and flipping
      // the active strand mid-scroll.
    });

    window.addEventListener('pointermove', (e) => {
      if (!active) return;
      if (!dragging) {
        const adx = Math.abs(e.clientX - startX);
        const ady = Math.abs(e.clientY - startY);
        // Vertical intent → release the pointer and let the browser scroll.
        if (ady > adx && ady > 8) { active = false; return; }
        // Horizontal intent → commit to a rotate and capture the pointer.
        if (adx > ady && adx > 8) {
          dragging = true;
          stage!.classList.add('is-dragging');
          try { stage!.setPointerCapture(e.pointerId); } catch {}
        } else {
          return; // not enough movement to decide yet
        }
      }
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      moved += Math.abs(dx);
      // Drag sensitivity: fixed on desktop (lower = calmer). On touch it is
      // width-relative — a ~55%-width swipe rotates one keyword step; the
      // fixed value would need a physically impossible ~750px swipe on phones.
      const sens = coarse ? STRAND_OFFSET / (window.innerWidth * 0.55) : 0.0028;
      targetSpin += dx * sens;
      startSmoothing();
    });

    function endDrag() {
      if (!active) return;
      active = false;
      const wasDrag = dragging;
      dragging = false;
      stage!.classList.remove('is-dragging');
      if (!wasDrag) return; // a tap (or aborted vertical) — nothing to snap
      if (moved > 6) {
        // Real drag: swallow the click so card links don't fire
        stage!.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); }, { capture: true, once: true });
      }
      // Snap the nearest header to front IMMEDIATELY on release.
      smoothing = false;
      cancelAnimationFrame(smoothRaf);
      snapToNearest();
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
    window.addEventListener('blur', endDrag);

    // Touch: a TAP on a keyword selects that strand (no drag needed). The
    // keyword headers are links, so we intercept the click while the carousel
    // is up and rotate instead of navigating. Desktop keeps click-to-navigate.
    stage.addEventListener('click', (e) => {
      if (!coarse || moved > 6) return;           // desktop, or this was a drag
      if (spiralProg(lastP) > 0.0005) return;      // only when fully centered (not shifted)
      const head = (e.target as HTMLElement).closest('.helix-head') as HTMLElement | null;
      if (!head) return;                           // taps elsewhere behave normally
      const s = Number(head.dataset.strand);
      // Tap-to-select, tap-again-to-open: a tap on the ALREADY-centered
      // keyword falls through to its link instead of a no-op re-select.
      if (s === activeStrand && Math.abs(normAngle(headerAngle(s, spin, lastP))) < 0.05) return;
      e.preventDefault();
      e.stopPropagation();
      selectStrand(s);
    }, { capture: true });

    // Arrow buttons rotate one keyword step — same centered-only guard as
    // drag/tap. pointerdown is stopped so a click never starts a stage drag.
    const arrowDirs: [HTMLElement | null, number][] = [[arrowPrev, -1], [arrowNext, +1]];
    for (const [btn, dir] of arrowDirs) {
      if (!btn) continue;
      btn.addEventListener('pointerdown', (e) => e.stopPropagation());
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (spiralProg(lastP) > 0.0005) return;
        rotateStep(dir);
      });
    }
  }

  if (wrap && cards.length > 0) {
    measure();
    computeActive();
    if (reduced) {
      // Static composition, no scroll listener — land in the formed helix
      // (past the keyword title screen) so content is visible at rest.
      render(0.55);
      if (hint) hint.style.opacity = '0';
    } else {
      render(0);
      // Fire the hero line-reveal one frame after first paint so the CSS
      // transition runs from the masked start state. (Reduced motion skips
      // this — the CSS media query shows the lines immediately.)
      requestAnimationFrame(() => title?.classList.add('is-in'));
      window.addEventListener('scroll', onScroll, { passive: true });
      // Mobile browser chrome (URL bar) show/hide fires HEIGHT-only resizes;
      // re-measuring then makes every card lurch mid-scroll. On touch devices
      // only re-measure when the width changes (rotation, split-screen).
      // Desktop resize behavior is unchanged.
      let lastResizeW = window.innerWidth;
      window.addEventListener('resize', () => {
        if (coarse && window.innerWidth === lastResizeW) return;
        lastResizeW = window.innerWidth;
        measure();
        onScroll();
      }, { passive: true });
    }
  }
</script>
