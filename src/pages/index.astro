---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Inseok Lee — Hydrogen × AI"
  description="MSc Chemical Engineering · KIST researcher · hydrogen × AI"
>
  <!-- ============================================================
       Stage 00 — Hero
       ============================================================ -->
  <section
    class="snap-section relative flex items-center justify-center"
    style="background: linear-gradient(180deg, #FFFFFF 0%, #FAFAFA 100%); padding-top: var(--nav-h);"
  >
    <div class="container-site w-full">
      <div class="flex flex-col lg:flex-row items-center justify-center gap-10 lg:gap-0 py-16">
        <!-- Left copy (overlaps photo from the left) -->
        <div class="flex-1 lg:text-right lg:relative lg:z-10 lg:-mr-20 xl:-mr-24">
          <h1 class="text-6xl lg:text-9xl font-bold leading-none" style="color: var(--ink);">
            Hi, I'm Inseok.
          </h1>
        </div>

        <!-- Center photo (sits behind text edges) -->
        <div class="flex-shrink-0 lg:relative lg:z-0">
          <img
            src="/images/home/me.png"
            alt="Inseok Lee"
            class="home-photo w-96 lg:w-[600px] h-[690px] lg:h-[840px] object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <!-- Right copy (overlaps photo from the right) -->
        <div class="flex-1 lg:text-left lg:relative lg:z-10 lg:-ml-20 xl:-ml-24">
          <h2 class="text-4xl lg:text-6xl font-bold leading-tight" style="color: var(--ink);">
            I am a researcher and also an engineer.
          </h2>
        </div>
      </div>
    </div>

  </section>

  <!-- ============================================================
       Stage 01 — Researcher (photo left)
       ============================================================ -->
  <section
    class="snap-section relative flex items-center"
    style="background: linear-gradient(180deg, #FAFAFA 0%, #F5F7FA 100%);"
  >
    <div class="container-site w-full">
      <div class="flex flex-col lg:flex-row items-center gap-16 py-24">
        <!-- Photo — LEFT -->
        <div class="flex-shrink-0 order-2 lg:order-1">
          <img
            src="/images/home/01-researcher.png"
            alt="Inseok Lee as researcher"
            class="home-photo w-96 lg:w-[570px] h-[690px] lg:h-[780px] object-cover"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Text block — RIGHT -->
        <div class="flex-1 order-1 lg:order-2 flex flex-col gap-6">
          <h2 class="text-section" style="color: var(--ink);">
            Experiments.
          </h2>
          <p class="text-base max-w-lg" style="color: var(--body); line-height: 1.7;">
            Bench-scale experiments on sodium borohydride (SBH) hydrolysis for on-demand
            hydrogen generation. Investigating catalyst performance, thermal behaviour,
            and process scalability for portable energy systems.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            {['SBH Hydrolysis', 'Catalyst', 'Hydrogen', 'Bench-scale'].map(chip => (
              <span class="chip">{chip}</span>
            ))}
          </div>
          <span class="block w-24 h-px mt-6" style="background-color: var(--accent);" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Stage 02 — Engineer (photo right)
       ============================================================ -->
  <section
    class="snap-section relative flex items-center"
    style="background: linear-gradient(180deg, #F5F7FA 0%, #F0F8FA 100%);"
  >
    <div class="container-site w-full">
      <div class="flex flex-col lg:flex-row items-center gap-16 py-24">
        <!-- Text block — LEFT -->
        <div class="flex-1 flex flex-col gap-6">
          <h2 class="text-section" style="color: var(--ink);">
            Simulation. Optimization.
          </h2>
          <p class="text-base max-w-lg" style="color: var(--body); line-height: 1.7;">
            Process simulation and multi-objective optimization (MOO) for hydrogen
            liquefaction and LOHC carrier systems. NSGA-II Pareto-front analysis across
            efficiency, cost, and carbon metrics using Aspen Plus + Python.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            {['CCPP-LOHC', 'Aspen Plus', 'NSGA-II', 'MOO'].map(chip => (
              <span class="chip">{chip}</span>
            ))}
          </div>
          <span class="block w-24 h-px mt-6" style="background-color: var(--accent);" aria-hidden="true"></span>
        </div>

        <!-- Photo — RIGHT -->
        <div class="flex-shrink-0">
          <img
            src="/images/home/02-engineer.png"
            alt="Inseok Lee as engineer"
            class="home-photo w-96 lg:w-[570px] h-[690px] lg:h-[780px] object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Stage 03 — Developer (photo left)
       ============================================================ -->
  <section
    class="snap-section relative flex items-center"
    style="background: linear-gradient(180deg, #F0F8FA 0%, #F5FAFC 100%);"
  >
    <div class="container-site w-full">
      <div class="flex flex-col lg:flex-row items-center gap-16 py-24">
        <!-- Photo — LEFT -->
        <div class="flex-shrink-0 order-2 lg:order-1">
          <img
            src="/images/home/03-developer.png"
            alt="Inseok Lee as developer"
            class="home-photo w-96 lg:w-[570px] h-[690px] lg:h-[780px] object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Text block — RIGHT -->
        <div class="flex-1 order-1 lg:order-2 flex flex-col gap-6">
          <h2 class="text-section" style="color: var(--ink);">
            Tools. Automation. AI.
          </h2>
          <p class="text-base max-w-lg" style="color: var(--body); line-height: 1.7;">
            Aspen Plus automation frameworks, SBH thermal solvers, and engineering
            productivity systems built on multi-agent AI. Custom dashboards for
            real-time process monitoring and optimization result visualization.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            {['Python', 'Aspen Automation', 'AI Agents', 'Dashboards'].map(chip => (
              <span class="chip">{chip}</span>
            ))}
          </div>
          <span class="block w-24 h-px mt-6" style="background-color: var(--accent);" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Stage 04 — Closing CTA
       ============================================================ -->
  <section
    class="snap-section relative flex items-center"
    style="background: linear-gradient(180deg, #F5FAFC 0%, #FFFFFF 100%);"
  >
    <div class="container-site w-full py-24">
      <div class="flex flex-col items-start gap-8 max-w-2xl">
        <h2 class="text-section" style="color: var(--ink);">
          Want to talk?
        </h2>
        <p class="text-base" style="color: var(--body);">
          Open to research collaborations, engineering roles, and conversations
          about hydrogen energy systems and AI tooling.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          <a
            href="mailto:inseok888@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm uppercase tracking-widest font-medium transition-colors duration-150"
            style="background-color: var(--accent); color: #FFFFFF;"
          >
            Email <span>→</span>
          </a>
          <a
            href="https://www.linkedin.com/in/inseok-lee-9085563a7"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm uppercase tracking-widest transition-colors duration-150"
            style="border: 1px solid var(--border); color: var(--body);"
            onmouseover="this.style.borderColor='var(--accent)';"
            onmouseout="this.style.borderColor='var(--border)';"
          >
            LinkedIn <span>→</span>
          </a>
          <a
            href="https://github.com/LEE-Inseok"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm uppercase tracking-widest transition-colors duration-150"
            style="border: 1px solid var(--border); color: var(--body);"
            onmouseover="this.style.borderColor='var(--accent)';"
            onmouseout="this.style.borderColor='var(--border)';"
          >
            GitHub <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<!--
  Global snap-scroll — applied only on the home page render.
  Astro's <style is:global> ships these rules in the HTML for / only;
  navigating to another page renders that page's CSS without these rules,
  so snap-scroll never leaks to research/code/recognition/etc.
-->
<style is:global>
  /* Home page photos — transparent PNG, blends into section gradient */
  .home-photo {
    display: block;
    background-color: transparent;
    border: none;
    /* Black & white treatment — comment out if you want original colors */
    /* filter: grayscale(100%); */
  }

  html {
    scroll-snap-type: y mandatory;
    scroll-padding-top: var(--nav-h);
    /* override globals.css scroll-behavior: smooth for crisp section-to-section snap */
    scroll-behavior: auto;
  }

  /* Each home-page section is exactly one viewport tall and snaps to its top */
  main > .snap-section {
    height: 100vh;
    height: 100dvh; /* dynamic viewport for mobile browser chrome */
    min-height: 100vh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Footer sits naturally at the end — also a snap point so it doesn't get cut off */
  body > footer {
    scroll-snap-align: end;
  }

  /* Respect users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-snap-type: none; }
    main > .snap-section { height: auto; min-height: 100vh; }
  }
</style>
