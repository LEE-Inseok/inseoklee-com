---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SBH Experiment — Research — Inseok Lee"
  description="Sodium borohydride hydrolysis bench-scale experiment for portable hydrogen generation."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/research" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Research</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">SBH Experiment.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Sodium borohydride hydrolysis · catalyst screening · bench-scale hydrogen generation
      </p>
    </header>

    <div class="max-w-2xl">
      <p class="text-base" style="color: var(--body);">
        [Research detail page — content coming in Day 4. Will include: 7 chapters with
        experimental methodology, results, and analysis.]
      </p>
    </div>
  </div>
</BaseLayout>
