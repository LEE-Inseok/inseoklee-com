---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('research', 'sbh-experiment');
if (!entry) throw new Error('Entry sbh-experiment not found in collection research');
const { Content } = await entry.render();
const { title, summary, tags, date } = entry.data;
---

<BaseLayout title={`${title} — Inseok Lee`} description={summary}>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <a
        href="/research"
        class="section-label transition-colors"
        style="color: var(--muted);"
        onmouseover="this.style.color='var(--accent)';"
        onmouseout="this.style.color='var(--muted)';"
      >← Research</a>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">{title}</h1>
      <p class="mt-3 text-base max-w-2xl" style="color: var(--muted);">{summary}</p>
      {date && <p class="mt-3 section-label">{date}</p>}
    </header>

    <article class="article max-w-2xl">
      <Content />
    </article>

    {tags && (
      <div class="flex flex-wrap mt-12 max-w-2xl">
        {tags.map(tag => <span class="chip">{tag}</span>)}
      </div>
    )}
  </div>
</BaseLayout>
