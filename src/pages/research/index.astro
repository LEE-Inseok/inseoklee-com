---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// Research is ONE collection; the `section` field splits it into areas.
// Every panel renders straight from the collection — presentation is decided
// by `status` alone: published → linked card, draft → linked + "In progress",
// coming-soon → unlinked dimmed stub (and no detail page is built for it).
// View ids / hash anchors equal the `section` field values.
const researchAll = await getCollection('research');
const statusOrder: Record<string, number> = { 'published': 0, 'draft': 1, 'coming-soon': 2 };
const bySection = (section: CollectionEntry<'research'>['data']['section']) =>
  researchAll
    .filter((e) => e.data.section === section)
    .sort(
      (a, b) =>
        (statusOrder[a.data.status] ?? 9) - (statusOrder[b.data.status] ?? 9) ||
        (a.data.date ?? '').localeCompare(b.data.date ?? '')
    );

const areas = [
  { view: 'system-engineering', label: 'System Engineering',        entries: bySection('system-engineering') },
  { view: 'simulation',         label: 'Simulation & Optimization', entries: bySection('simulation') },
  { view: 'ald',                label: 'ALD',                       entries: bySection('ald') },
];

const publications = (await getCollection('publications')).sort((a, b) => {
  const order = { 'published': 0, 'under-review': 1, 'submitted': 2, 'draft': 3, 'in-preparation': 4 };
  return (order[a.data.status] ?? 9) - (order[b.data.status] ?? 9);
});

const statusLabel: Record<string, string> = {
  'submitted':      'Submitted',
  'under-review':   'Under review',
  'draft':          'Draft',
  'in-preparation': 'In preparation',
  'published':      'Published',
};

const navGroups = [
  {
    key: 'area',
    label: 'Area',
    trigger: 'expand' as const,
    items: areas.map(({ view, label }) => ({ view, label })),
  },
  {
    key: 'publications',
    label: 'Publications',
    trigger: 'activate' as const,
    activateView: 'publications',
  },
];
---

<BaseLayout
  title="Research — Inseok Lee"
  description="Research on hydrogen energy systems — experimental work, simulation, optimization, and publications."
  section="research"
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Research</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Research.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Process systems, end-to-end — hands-on system engineering, thermal simulation & optimization, ALD processes, and publications.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          <CategoryNav
            groups={navGroups}
            defaultView="system-engineering"
            ariaLabel="Research categories"
          />
        </div>
      </aside>

      <div class="flex-1 min-w-0">

        {areas.map((area) => (
          <section data-view-panel={area.view} hidden aria-labelledby="cn-area-trigger">
            <h2 class="view-title">Area · {area.label}</h2>
            <div class="flex flex-col max-w-2xl">
              {area.entries.length === 0 && (
                <p class="text-base" style="color: var(--muted);">No projects recorded yet.</p>
              )}
              {area.entries.map((entry, i) => {
                const num = String(i + 1).padStart(2, '0');
                const soon = entry.data.status === 'coming-soon';
                return (
                  <a href={`/research/${entry.slug}`} class="card flex gap-5 group" data-stub={soon ? 'true' : undefined} data-reveal style={`transition-delay: ${i * 70}ms`}>
                    <span class="row-num" aria-hidden="true">{num}</span>
                    <div class="flex flex-col gap-3 min-w-0">
                      {soon && (
                        <span class="section-label" style="color: var(--muted);">Coming soon</span>
                      )}
                      {entry.data.status === 'draft' && (
                        <span class="section-label" style="color: var(--accent-dk);">In progress</span>
                      )}
                      <h4 class="card-title" style={soon ? 'color: var(--muted);' : undefined}>{entry.data.title}</h4>
                      <p class="text-base" style={soon ? 'color: var(--muted);' : 'color: var(--body);'}>{entry.data.summary}</p>
                      <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}

        <!-- Publications -->
        <section data-view-panel="publications" hidden aria-labelledby="cn-publications-trigger">
          <h2 class="view-title">Publications</h2>
          <div class="flex flex-col max-w-2xl">
            {publications.map((pub, i) => {
              const isPending = pub.data.status === 'in-preparation' || pub.data.status === 'draft';
              const num = String(i + 1).padStart(2, '0');
              return (
                <div class="card flex gap-5" data-pending={isPending ? 'true' : undefined} data-reveal style={`transition-delay: ${i * 70}ms`}>
                  <span class="row-num" aria-hidden="true">{num}</span>
                  <div class="flex flex-col gap-3 min-w-0 flex-1">
                    <div class="flex items-center justify-between">
                      <span class="section-label" style={isPending ? 'color: var(--muted);' : 'color: var(--accent-dk);'}>{statusLabel[pub.data.status] ?? pub.data.status}</span>
                      {pub.data.date && <span class="section-label">{pub.data.date}</span>}
                    </div>
                    <h3 class="card-title" style={isPending ? 'color: var(--muted);' : undefined}>{pub.data.title}</h3>
                    <p class="text-base" style={isPending ? 'color: var(--muted);' : 'color: var(--body);'}>{pub.data.summary}</p>
                    {pub.data.target && <p class="text-sm" style="color: var(--muted);">Target: {pub.data.target}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
  [data-view-panel] {
    transition: opacity 150ms ease;
  }
  [data-view-panel][hidden] {
    display: none;
  }
  [data-stub="true"] {
    opacity: 0.65;
  }
</style>
