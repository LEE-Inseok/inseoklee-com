---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const experimental = (await getCollection('research')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const simulation = (await getCollection('engineering')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const publications = (await getCollection('publications')).sort((a, b) => {
  const order = { 'published': 0, 'under-review': 1, 'submitted': 2, 'draft': 3, 'in-preparation': 4 };
  return (order[a.data.status] ?? 9) - (order[b.data.status] ?? 9);
});

const statusLabel: Record<string, string> = {
  'submitted':      'Submitted',
  'under-review':   'Under review',
  'draft':          'Draft',
  'in-preparation': 'In preparation',
  'published':      'Published',
};
---

<BaseLayout
  title="Research — Inseok Lee"
  description="Research on hydrogen energy systems — experimental work, simulation, optimization, and publications."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Research</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Research.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Hydrogen energy systems — experimental, simulation, optimization, and publications.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <!-- LEFT: dropdown nav -->
      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <nav class="lg:sticky lg:top-24 flex flex-col gap-2">

          <!-- Group: Area -->
          <div class="nav-group" data-group="area">
            <button class="group-trigger active" data-view="all">Area</button>
            <ul class="submenu">
              <li><button class="sub-item active" data-view="all">All</button></li>
              <li><button class="sub-item" data-view="experimental">Experimental</button></li>
              <li><button class="sub-item" data-view="simulation">Simulation and Optimization</button></li>
            </ul>
          </div>

          <!-- Group: Publication -->
          <div class="nav-group" data-group="publication">
            <button class="group-trigger" data-view="publication">Publication</button>
            <ul class="submenu">
              <li><button class="sub-item" data-view="publication">All Manuscripts</button></li>
            </ul>
          </div>

        </nav>
      </aside>

      <!-- RIGHT: content views -->
      <div class="flex-1 min-w-0">

        <!-- All Area -->
        <section class="view-section" data-view="all">
          <h2 class="view-title">Area · All</h2>
          <div class="mb-12">
            <div class="flex items-center gap-3 mb-4">
              <span class="block w-8 h-px" style="background-color: var(--accent);"></span>
              <h3 class="sub-label">Experimental</h3>
            </div>
            <div class="flex flex-col max-w-2xl">
              {experimental.map((item) => (
                <a href={`/research/${item.slug}`} class="card flex flex-col gap-3 group">
                  {item.data.date && <span class="section-label">{item.data.date}</span>}
                  <h4 class="card-title">{item.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              ))}
            </div>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="block w-8 h-px" style="background-color: var(--accent);"></span>
              <h3 class="sub-label">Simulation and Optimization</h3>
            </div>
            <div class="flex flex-col max-w-2xl">
              {simulation.map((item) => (
                <a href={`/engineering/${item.slug}`} class="card flex flex-col gap-3 group">
                  {item.data.date && <span class="section-label">{item.data.date}</span>}
                  <h4 class="card-title">{item.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="view-section hidden" data-view="experimental">
          <h2 class="view-title">Area · Experimental</h2>
          <div class="flex flex-col max-w-2xl">
            {experimental.map((item) => (
              <a href={`/research/${item.slug}`} class="card flex flex-col gap-3 group">
                {item.data.date && <span class="section-label">{item.data.date}</span>}
                <h4 class="card-title">{item.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
              </a>
            ))}
          </div>
        </section>

        <section class="view-section hidden" data-view="simulation">
          <h2 class="view-title">Area · Simulation and Optimization</h2>
          <div class="flex flex-col max-w-2xl">
            {simulation.map((item) => (
              <a href={`/engineering/${item.slug}`} class="card flex flex-col gap-3 group">
                {item.data.date && <span class="section-label">{item.data.date}</span>}
                <h4 class="card-title">{item.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
              </a>
            ))}
          </div>
        </section>

        <section class="view-section hidden" data-view="publication">
          <h2 class="view-title">Publication</h2>
          <div class="flex flex-col max-w-2xl">
            {publications.map((pub) => (
              <div class="card flex flex-col gap-3">
                <div class="flex items-center justify-between">
                  <span class="section-label" style="color: var(--accent-dk);">{statusLabel[pub.data.status] ?? pub.data.status}</span>
                  {pub.data.date && <span class="section-label">{pub.data.date}</span>}
                </div>
                <h3 class="card-title">{pub.data.title}</h3>
                <p class="text-base" style="color: var(--body);">{pub.data.summary}</p>
                {pub.data.target && <p class="text-sm" style="color: var(--muted);">Target: {pub.data.target}</p>}
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nav-group {
    position: relative;
  }

  .group-trigger {
    display: block;
    text-align: left;
    width: 100%;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    color: var(--muted);
    cursor: pointer;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .group-trigger:hover { color: var(--ink); }
  .group-trigger.active {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  /* Submenu collapses by default */
  .submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 200ms ease;
    margin: 0;
    padding-left: 0.75rem;
    list-style: none;
  }
  .nav-group:hover .submenu,
  .nav-group:focus-within .submenu,
  .nav-group.open .submenu {
    max-height: 240px;
  }

  .sub-item {
    display: block;
    text-align: left;
    width: 100%;
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    color: var(--muted);
    cursor: pointer;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .sub-item:hover { color: var(--ink); }
  .sub-item.active {
    color: var(--ink);
    font-weight: 700;
    border-left-color: var(--accent);
  }

  /* Mobile: always show submenu (no hover) */
  @media (max-width: 1023px) {
    .submenu { max-height: 240px; padding-left: 0.5rem; }
    .nav-group { margin-bottom: 0.5rem; }
  }

  .view-section.hidden { display: none; }
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .sub-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-dk);
    font-weight: 700;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
</style>

<script>
  const groupTriggers = document.querySelectorAll<HTMLButtonElement>('.group-trigger');
  const subItems = document.querySelectorAll<HTMLButtonElement>('.sub-item');
  const views = document.querySelectorAll<HTMLElement>('.view-section');
  const groupNodes = document.querySelectorAll<HTMLElement>('.nav-group');

  // Maps view name -> group it belongs to
  const viewToGroup: Record<string, string> = {
    'all': 'area',
    'experimental': 'area',
    'simulation': 'area',
    'publication': 'publication',
  };

  function activateView(view: string) {
    views.forEach((v) => v.classList.toggle('hidden', v.dataset.view !== view));
    subItems.forEach((s) => s.classList.toggle('active', s.dataset.view === view));
    const targetGroup = viewToGroup[view] ?? '';
    groupTriggers.forEach((t) => {
      const g = (t.closest('.nav-group') as HTMLElement | null)?.dataset.group ?? '';
      t.classList.toggle('active', g === targetGroup);
    });
  }

  groupTriggers.forEach((t) => {
    t.addEventListener('click', () => {
      const view = t.dataset.view;
      if (view) activateView(view);
    });
  });
  subItems.forEach((s) => {
    s.addEventListener('click', () => {
      const view = s.dataset.view;
      if (view) activateView(view);
    });
  });

  // Mobile: tap group-trigger to toggle submenu open state
  if (window.matchMedia('(max-width: 1023px)').matches) {
    groupNodes.forEach((g) => g.classList.add('open'));
  }
</script>
