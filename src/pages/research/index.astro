---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('research')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
---

<BaseLayout
  title="Research — Inseok Lee"
  description="Bench-scale experimental research on hydrogen energy systems."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Research</span>
      <h1 class="text-section mt-3" style="color: var(--ink);">Research.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Bench-scale experimental research on hydrogen energy systems.
      </p>
    </header>

    <div class="flex flex-col max-w-3xl">
      {items.map((item, idx) => (
        <a href={`/research/${item.slug}`} class="card flex flex-col gap-3 group">
          <div class="flex items-center justify-between">
            <span class="section-label">{String(idx + 1).padStart(2, '0')}</span>
            <span class="section-label" style={`color: ${item.data.status === 'published' ? 'var(--accent-dk)' : 'var(--muted)'};`}>{item.data.status}</span>
          </div>
          <h2 class="text-2xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">{item.data.title}</h2>
          <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
          <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
