---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const experimental = (await getCollection('research')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const simulation = (await getCollection('engineering')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const publications = (await getCollection('publications')).sort((a, b) => {
  const order = { 'published': 0, 'under-review': 1, 'submitted': 2, 'draft': 3, 'in-preparation': 4 };
  return (order[a.data.status] ?? 9) - (order[b.data.status] ?? 9);
});

const statusLabel: Record<string, string> = {
  'submitted':      'Submitted',
  'under-review':   'Under review',
  'draft':          'Draft',
  'in-preparation': 'In preparation',
  'published':      'Published',
};
---

<BaseLayout
  title="Research — Inseok Lee"
  description="Research on hydrogen energy systems — experimental work, simulation, optimization, and publications."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Research</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Research.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Hydrogen energy systems — experimental, simulation, optimization, and publications.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <!-- LEFT: nested category nav -->
      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <nav class="lg:sticky lg:top-24 flex lg:flex-col gap-1 flex-wrap">
          <span class="nav-group-label">Area</span>
          <button class="side-tab active" data-view="all">All</button>
          <button class="side-tab" data-view="experimental">Experimental</button>
          <button class="side-tab" data-view="simulation">Simulation and Optimization</button>

          <span class="nav-group-label mt-4 lg:mt-6">Publication</span>
          <button class="side-tab" data-view="publication">All Manuscripts</button>
        </nav>
      </aside>

      <!-- RIGHT: content views -->
      <div class="flex-1 min-w-0">

        <!-- All Area view -->
        <section class="view-section" data-view="all">
          <h2 class="view-title">Area · All</h2>

          <div class="mb-12">
            <div class="flex items-center gap-3 mb-4">
              <span class="block w-8 h-px" style="background-color: var(--accent);"></span>
              <h3 class="sub-label">Experimental</h3>
            </div>
            <div class="flex flex-col max-w-2xl">
              {experimental.map((item) => (
                <a href={`/research/${item.slug}`} class="card flex flex-col gap-3 group">
                  {item.data.date && <span class="section-label">{item.data.date}</span>}
                  <h4 class="card-title">{item.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              ))}
            </div>
          </div>

          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="block w-8 h-px" style="background-color: var(--accent);"></span>
              <h3 class="sub-label">Simulation and Optimization</h3>
            </div>
            <div class="flex flex-col max-w-2xl">
              {simulation.map((item) => (
                <a href={`/engineering/${item.slug}`} class="card flex flex-col gap-3 group">
                  {item.data.date && <span class="section-label">{item.data.date}</span>}
                  <h4 class="card-title">{item.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- Experimental only -->
        <section class="view-section hidden" data-view="experimental">
          <h2 class="view-title">Area · Experimental</h2>
          <div class="flex flex-col max-w-2xl">
            {experimental.map((item) => (
              <a href={`/research/${item.slug}`} class="card flex flex-col gap-3 group">
                {item.data.date && <span class="section-label">{item.data.date}</span>}
                <h4 class="card-title">{item.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Simulation only -->
        <section class="view-section hidden" data-view="simulation">
          <h2 class="view-title">Area · Simulation and Optimization</h2>
          <div class="flex flex-col max-w-2xl">
            {simulation.map((item) => (
              <a href={`/engineering/${item.slug}`} class="card flex flex-col gap-3 group">
                {item.data.date && <span class="section-label">{item.data.date}</span>}
                <h4 class="card-title">{item.data.title}</h4>
                <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Publication view -->
        <section class="view-section hidden" data-view="publication">
          <h2 class="view-title">Publication</h2>
          <div class="flex flex-col max-w-2xl">
            {publications.map((pub) => (
              <div class="card flex flex-col gap-3">
                <div class="flex items-center justify-between">
                  <span class="section-label" style="color: var(--accent-dk);">{statusLabel[pub.data.status] ?? pub.data.status}</span>
                  {pub.data.date && <span class="section-label">{pub.data.date}</span>}
                </div>
                <h3 class="card-title">{pub.data.title}</h3>
                <p class="text-base" style="color: var(--body);">{pub.data.summary}</p>
                {pub.data.target && <p class="text-sm" style="color: var(--muted);">Target: {pub.data.target}</p>}
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nav-group-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.25rem 0;
    margin-top: 0.5rem;
  }
  .side-tab {
    text-align: left;
    font-size: 0.875rem;
    padding: 0.4rem 0.75rem;
    color: var(--muted);
    font-weight: 500;
    background: transparent;
    cursor: pointer;
    border-left: 2px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .side-tab:hover { color: var(--ink); }
  .side-tab.active {
    color: var(--ink);
    font-weight: 700;
    border-left-color: var(--accent);
  }
  @media (max-width: 1023px) {
    .side-tab {
      border-left: none;
      border-bottom: 2px solid transparent;
    }
    .side-tab.active { border-bottom-color: var(--accent); }
    .nav-group-label { width: 100%; }
  }

  .view-section.hidden { display: none; }
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .sub-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-dk);
    font-weight: 700;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
</style>

<script>
  const sideTabs = document.querySelectorAll<HTMLButtonElement>('.side-tab');
  const views = document.querySelectorAll<HTMLElement>('.view-section');
  sideTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view = tab.dataset.view;
      sideTabs.forEach((t) => t.classList.toggle('active', t === tab));
      views.forEach((v) => v.classList.toggle('hidden', v.dataset.view !== view));
    });
  });
</script>
