---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCollection } from 'astro:content';

const experimental = (await getCollection('research')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const simulation = (await getCollection('engineering')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const publications = (await getCollection('publications')).sort((a, b) => {
  const order = { 'published': 0, 'under-review': 1, 'submitted': 2, 'draft': 3, 'in-preparation': 4 };
  return (order[a.data.status] ?? 9) - (order[b.data.status] ?? 9);
});

const statusLabel: Record<string, string> = {
  'submitted':      'Submitted',
  'under-review':   'Under review',
  'draft':          'Draft',
  'in-preparation': 'In preparation',
  'published':      'Published',
};

const navGroups = [
  {
    key: 'area',
    label: 'Area',
    trigger: 'expand' as const,
    items: [
      { view: 'experimental', label: 'Experimental' },
      { view: 'simulation',   label: 'Simulation' },
    ],
  },
  {
    key: 'publication',
    label: 'Publication',
    trigger: 'activate' as const,
    activateView: 'publication',
  },
];

const experimentalPlaceholders = [
  { title: 'SBH Hydrogen Energy System — Small scale', summary: 'Bench-scale integrated testbed converting sodium borohydride hydrolysis into electricity via PEM fuel cell.', existingSlug: 'sbh-experiment' },
  { title: 'SBH Hydrogen Energy System — Large scale', summary: 'Scale-up study toward armoured-vehicle-class SBH system with full coolant loop redesign.', existingSlug: null },
  { title: 'SBH Hydrogen Energy System — Regulatory Approval', summary: 'Certification and safety review track for portable SBH-based power systems.', existingSlug: null },
  { title: 'PEMFC', summary: 'Proton-exchange-membrane fuel cell characterization — IV curves, EIS, and CO sensitivity.', existingSlug: null },
];

const simulationPlaceholders = [
  { title: 'SBH Thermal Simulation', summary: 'Physics-based thermal scenario study across 5 heat-recovery configurations for the SBH hydrogen system.', existingSlug: 'sbh-thermal' },
  { title: 'LOHC-CCPP Thermal Coupling System Optimization', summary: 'Multi-objective optimization of CCPP integrated with LOHC hydrogen production — Aspen + ML surrogate + NSGA-II.', existingSlug: 'ccpp-lohc' },
  { title: 'Dynamic System Modeling', summary: 'Time-resolved system dynamics for transient and start-up scenarios in hydrogen energy systems.', existingSlug: null },
];

function experimentalEntry(slug: string | null) {
  if (!slug) return null;
  return experimental.find((e) => e.slug === slug) ?? null;
}
function simulationEntry(slug: string | null) {
  if (!slug) return null;
  return simulation.find((e) => e.slug === slug) ?? null;
}
---

<BaseLayout
  title="Research — Inseok Lee"
  description="Research on hydrogen energy systems — experimental work, simulation, optimization, and publications."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Research</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Research.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Hydrogen energy systems — experimental, simulation, optimization, and publications.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          <CategoryNav
            groups={navGroups}
            defaultView="publication"
            ariaLabel="Research categories"
          />
        </div>
      </aside>

      <div class="flex-1 min-w-0">

        <!-- Experimental — all items are active/in-progress, rendered in full color -->
        <section data-view-panel="experimental" hidden aria-labelledby="cn-area-trigger">
          <h2 class="view-title">Area · Experimental</h2>
          <div class="flex flex-col max-w-2xl">
            {experimentalPlaceholders.map((p) => {
              const real = experimentalEntry(p.existingSlug);
              if (real) {
                return (
                  <a href={`/research/${real.slug}`} class="card flex flex-col gap-3 group">
                    <h4 class="card-title">{real.data.title}</h4>
                    <p class="text-base" style="color: var(--body);">{real.data.summary}</p>
                    <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                  </a>
                );
              }
              return (
                <div class="card flex flex-col gap-3">
                  <h4 class="card-title">{p.title}</h4>
                  <p class="text-base" style="color: var(--body);">{p.summary}</p>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Simulation -->
        <section data-view-panel="simulation" hidden aria-labelledby="cn-area-trigger">
          <h2 class="view-title">Area · Simulation</h2>
          <div class="flex flex-col max-w-2xl">
            {simulationPlaceholders.map((p) => {
              const real = simulationEntry(p.existingSlug);
              if (real) {
                return (
                  <a href={`/engineering/${real.slug}`} class="card flex flex-col gap-3 group">
                    <h4 class="card-title">{real.data.title}</h4>
                    <p class="text-base" style="color: var(--body);">{real.data.summary}</p>
                    <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                  </a>
                );
              }
              return (
                <div class="card flex flex-col gap-3" data-stub="true">
                  <span class="section-label" style="color: var(--muted);">In preparation</span>
                  <h4 class="card-title" style="color: var(--muted);">{p.title}</h4>
                  <p class="text-base" style="color: var(--muted);">{p.summary}</p>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Publication -->
        <section data-view-panel="publication" hidden aria-labelledby="cn-publication-trigger">
          <h2 class="view-title">Publication</h2>
          <div class="flex flex-col max-w-2xl">
            {publications.map((pub) => {
              const isPending = pub.data.status === 'in-preparation' || pub.data.status === 'draft';
              return (
                <div class="card flex flex-col gap-3" data-pending={isPending ? 'true' : undefined}>
                  <div class="flex items-center justify-between">
                    <span class="section-label" style={isPending ? 'color: var(--muted);' : 'color: var(--accent-dk);'}>{statusLabel[pub.data.status] ?? pub.data.status}</span>
                    {pub.data.date && <span class="section-label">{pub.data.date}</span>}
                  </div>
                  <h3 class="card-title" style={isPending ? 'color: var(--muted);' : undefined}>{pub.data.title}</h3>
                  <p class="text-base" style={isPending ? 'color: var(--muted);' : 'color: var(--body);'}>{pub.data.summary}</p>
                  {pub.data.target && <p class="text-sm" style="color: var(--muted);">Target: {pub.data.target}</p>}
                </div>
              );
            })}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
  [data-view-panel] {
    transition: opacity 150ms ease;
  }
  [data-view-panel][hidden] {
    display: none;
  }
  [data-stub="true"] {
    opacity: 0.65;
  }
</style>
