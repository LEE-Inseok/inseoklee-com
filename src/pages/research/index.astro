---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const experimental = (await getCollection('research')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const simulation = (await getCollection('engineering')).sort(
  (a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')
);
const publications = (await getCollection('publications')).sort((a, b) => {
  const order = { 'published': 0, 'under-review': 1, 'submitted': 2, 'draft': 3, 'in-preparation': 4 };
  return (order[a.data.status] ?? 9) - (order[b.data.status] ?? 9);
});

const statusLabel: Record<string, string> = {
  'submitted':      'Submitted',
  'under-review':   'Under review',
  'draft':          'Draft',
  'in-preparation': 'In preparation',
  'published':      'Published',
};
---

<BaseLayout
  title="Research — Inseok Lee"
  description="Research on hydrogen energy systems — experimental work, simulation, optimization, and publications."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Research</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Research.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Hydrogen energy systems — experimental, simulation, optimization, and publications.
      </p>
    </header>

    <!-- ─── Split layout: left side-nav + right content ─────────────────── -->
    <div class="flex flex-col lg:flex-row lg:gap-12">

      <!-- LEFT: side category nav -->
      <aside class="lg:w-48 flex-shrink-0 mb-8 lg:mb-0">
        <nav class="lg:sticky lg:top-24">
          <div class="flex lg:flex-col gap-2 lg:gap-1">
            <button
              class="side-tab active text-left text-sm py-2 px-3 transition-colors"
              data-view="area"
            >
              Area
            </button>
            <button
              class="side-tab text-left text-sm py-2 px-3 transition-colors"
              data-view="publication"
            >
              Publication
            </button>
          </div>
        </nav>
      </aside>

      <!-- RIGHT: content -->
      <div class="flex-1 min-w-0">

        <!-- ─ Area view ─ -->
        <section class="view-section" data-view="area">
          <h2 class="text-2xl mb-6" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">Area</h2>

          <!-- Area sub-tabs -->
          <div class="flex flex-wrap gap-x-8 gap-y-2 mb-10 border-b" style="border-color: var(--border);">
            <button class="area-tab active pb-3 text-sm transition-colors" data-area="all">All</button>
            <button class="area-tab pb-3 text-sm transition-colors" data-area="experimental">Experimental</button>
            <button class="area-tab pb-3 text-sm transition-colors" data-area="simulation">Simulation and Optimization</button>
          </div>

          <!-- Experimental -->
          <div class="area-section mb-14" data-area="experimental">
            <div class="flex items-center gap-3 mb-4">
              <span class="block w-8 h-px" style="background-color: var(--accent);"></span>
              <h3 class="text-xs uppercase tracking-widest" style="color: var(--accent-dk); font-weight: 700;">Experimental</h3>
            </div>
            <div class="flex flex-col max-w-2xl">
              {experimental.map((item) => (
                <a href={`/research/${item.slug}`} class="card flex flex-col gap-3 group">
                  {item.data.date && <span class="section-label">{item.data.date}</span>}
                  <h4 class="text-xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">{item.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Simulation and Optimization -->
          <div class="area-section" data-area="simulation">
            <div class="flex items-center gap-3 mb-4">
              <span class="block w-8 h-px" style="background-color: var(--accent);"></span>
              <h3 class="text-xs uppercase tracking-widest" style="color: var(--accent-dk); font-weight: 700;">Simulation and Optimization</h3>
            </div>
            <div class="flex flex-col max-w-2xl">
              {simulation.map((item) => (
                <a href={`/engineering/${item.slug}`} class="card flex flex-col gap-3 group">
                  {item.data.date && <span class="section-label">{item.data.date}</span>}
                  <h4 class="text-xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">{item.data.title}</h4>
                  <p class="text-base" style="color: var(--body);">{item.data.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- ─ Publication view ─ -->
        <section class="view-section hidden" data-view="publication">
          <h2 class="text-2xl mb-8" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">Publication</h2>

          <div class="flex flex-col max-w-2xl">
            {publications.map((pub) => (
              <div class="card flex flex-col gap-3">
                <div class="flex items-center justify-between">
                  <span class="section-label" style="color: var(--accent-dk);">{statusLabel[pub.data.status] ?? pub.data.status}</span>
                  {pub.data.date && <span class="section-label">{pub.data.date}</span>}
                </div>
                <h3 class="text-xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">{pub.data.title}</h3>
                <p class="text-base" style="color: var(--body);">{pub.data.summary}</p>
                {pub.data.target && <p class="text-sm" style="color: var(--muted);">Target: {pub.data.target}</p>}
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Side category tabs (Area / Publication) */
  .side-tab {
    color: var(--muted);
    font-weight: 500;
    background: transparent;
    cursor: pointer;
    border-left: 2px solid transparent;
  }
  .side-tab:hover {
    color: var(--ink);
  }
  .side-tab.active {
    color: var(--ink);
    font-weight: 700;
    border-left-color: var(--accent);
  }
  /* Mobile: side-tabs become horizontal pill-ish */
  @media (max-width: 1023px) {
    .side-tab {
      border-left: none;
      border-bottom: 2px solid transparent;
    }
    .side-tab.active {
      border-bottom-color: var(--accent);
    }
  }
  .view-section.hidden {
    display: none;
  }

  /* Area sub-tabs */
  .area-tab {
    color: var(--muted);
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    cursor: pointer;
  }
  .area-tab:hover {
    color: var(--ink);
  }
  .area-tab.active {
    color: var(--ink);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
  .area-section.hidden {
    display: none;
  }
</style>

<script>
  // Outer: Area / Publication
  const sideTabs = document.querySelectorAll<HTMLButtonElement>('.side-tab');
  const views = document.querySelectorAll<HTMLElement>('.view-section');
  sideTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view = tab.dataset.view;
      sideTabs.forEach((t) => t.classList.toggle('active', t === tab));
      views.forEach((v) => v.classList.toggle('hidden', v.dataset.view !== view));
    });
  });

  // Inner (Area): All / Experimental / Simulation
  const areaTabs = document.querySelectorAll<HTMLButtonElement>('.area-tab');
  const areaSections = document.querySelectorAll<HTMLElement>('.area-section');
  areaTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const area = tab.dataset.area;
      areaTabs.forEach((t) => t.classList.toggle('active', t === tab));
      areaSections.forEach((s) => {
        const match = area === 'all' || s.dataset.area === area;
        s.classList.toggle('hidden', !match);
      });
    });
  });
</script>
