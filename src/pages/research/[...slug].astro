---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// Every research entry gets a detail page automatically, except coming-soon
// stubs — those render only as unlinked cards on the index.
export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries
    .filter((entry) => entry.data.status !== 'coming-soon')
    .map((entry) => ({
      params: { slug: entry.slug },
      props:  { entry },
    }));
}

type Props = { entry: CollectionEntry<'research'> };
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, tags, date, images, section } = entry.data;
---

<BaseLayout title={`${title} — Inseok Lee`} description={summary} section="research">
  <ProjectDetail
    backHref={`/research#${section}`}
    backLabel="Research"
    title={title}
    summary={summary}
    date={date}
    tags={tags}
    images={images}
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
