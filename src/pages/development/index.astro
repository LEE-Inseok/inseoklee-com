---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('development');
const frameworks = tools.filter(t => t.data.type === 'framework');
---

<BaseLayout
  title="Development — Inseok Lee"
  description="Code, automation frameworks, engineering productivity systems, and dashboards."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Development</span>
      <h1 class="text-section mt-3" style="color: var(--ink);">Code. Automation. AI.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Engineering tools, automation frameworks, and productivity systems built to
        accelerate research and simulation workflows.
      </p>
    </header>

    <div class="flex flex-col max-w-3xl">
      <a href="/development/code" class="card flex flex-col gap-3 group">
        <div class="flex items-center justify-between">
          <span class="section-label">01</span>
          <span class="section-label" style="color: var(--accent-dk);">{frameworks.length} items</span>
        </div>
        <h2 class="text-2xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">Code & Frameworks</h2>
        <p class="text-base" style="color: var(--body);">
          Aspen Plus automation pipeline and SBH thermal reactor framework — the codebase behind every simulation result.
        </p>
        <span class="text-sm mt-1" style="color: var(--accent-dk);">View →</span>
      </a>

      <a href="/development/engineering-productivity" class="card flex flex-col gap-3 group">
        <div class="flex items-center justify-between">
          <span class="section-label">02</span>
          <span class="section-label">coming soon</span>
        </div>
        <h2 class="text-2xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">Engineering Productivity</h2>
        <p class="text-base" style="color: var(--body);">
          Multi-agent AI workflow system designed for engineering research — architecture, automation rules, and human-authorship boundaries.
        </p>
        <span class="text-sm mt-1" style="color: var(--accent-dk);">View →</span>
      </a>

      <a href="/development/dashboards" class="card flex flex-col gap-3 group">
        <div class="flex items-center justify-between">
          <span class="section-label">03</span>
          <span class="section-label">coming soon</span>
        </div>
        <h2 class="text-2xl" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">Dashboards</h2>
        <p class="text-base" style="color: var(--body);">
          Real-time process monitoring and optimization-result dashboards built locally.
        </p>
        <span class="text-sm mt-1" style="color: var(--accent-dk);">View →</span>
      </a>
    </div>
  </div>
</BaseLayout>
