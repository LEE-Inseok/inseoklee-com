---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('development');

const navGroups = [
  {
    key: 'ai',
    label: 'AI',
    trigger: 'expand' as const,
    items: [
      { view: 'workflow', label: 'Workflow' },
      { view: 'harness',  label: 'Harness Engineering' },
    ],
  },
  {
    key: 'project',
    label: 'Project',
    trigger: 'activate' as const,
    activateView: 'project',
  },
];

// AI · Workflow — three tiers of AI usage
const workflowItems = [
  {
    title: 'Claude',
    summary: 'General chat for ideation, quick research questions, drafting, and lightweight summarisation — no codebase context, no tool-use.',
  },
  {
    title: 'Claude Code',
    summary: 'Coding work in VS Code extension or the desktop app — file edits, repo-aware refactoring, terminal-integrated debugging, and review loops.',
  },
  {
    title: 'Multi-Agent Orchestration',
    summary: 'Three-stage execution: Plan Mode → Codex cross-validation → specialist subagents (developer / debugger / analyst / tester / verifier) running the implementation.',
  },
];

// AI · Harness Engineering — tooling that customises the Claude harness
const harnessItems = [
  {
    title: 'MCP Servers',
    summary: 'Model Context Protocol servers connecting Claude to external systems — filesystem, browser, EndNote, Notion, Google Drive, and scheduled tasks.',
  },
  {
    title: 'Skills',
    summary: 'Reusable capability bundles auto-loaded per task — PDF, DOCX, XLSX, PPTX, design review, research synthesis, and project-specific helpers.',
  },
  {
    title: 'Hooks',
    summary: 'Event-driven automations along the agent lifecycle — pre/post tool, session start/stop, prompt submission gates, and stop-time review hooks.',
  },
  {
    title: 'Subagents',
    summary: 'Specialist Claude agents (developer / debugger / architect / researcher / analyst / tester / tech-writer / verifier) coordinated by an orchestrator.',
  },
  {
    title: 'Slash Commands',
    summary: 'Project-scoped commands that wrap recurring workflows — /codex:rescue, /codex:review, /research-toolkit, /sync-papers, /portfolio-update, etc.',
  },
];

// Project — concrete deliverables built with AI-assisted coding
const projectItems = [
  {
    title: 'Aspen Automation Framework',
    summary: 'Python pipeline for Aspen Plus — DOE, parallel simulation, surrogate training, NSGA-II / Bayesian optimization.',
    existingSlug: 'aspen-automation',
    externalHref: null,
  },
  {
    title: 'SBH Thermal Simulation Framework',
    summary: 'ODE-based thermal framework — model / scenario / execution layers across 5 reactor configurations.',
    existingSlug: 'sbh-framework',
    externalHref: null,
  },
  {
    title: 'Dashboard',
    summary: 'Local HTML dashboards for Pareto front, grid sweep, weekly research updates — annotated figures and convergence views.',
    existingSlug: null,
    externalHref: '/development/dashboards',
  },
  {
    title: 'Presentation',
    summary: 'Slide-format research updates and conference materials — methodology walkthroughs and annotated figures.',
    existingSlug: null,
    externalHref: '/development/engineering-productivity',
  },
  {
    title: 'Portfolio Site',
    summary: 'This very site — Astro + Tailwind + Cloudflare Pages. Source of truth for research, code, and recognition.',
    existingSlug: null,
    externalHref: 'https://github.com/LEE-Inseok/inseoklee-com',
  },
];

function projectEntry(slug: string | null) {
  if (!slug) return null;
  return allTools.find((t) => t.slug === slug) ?? null;
}
---

<BaseLayout
  title="Code — Inseok Lee"
  description="Engineering tools, automation frameworks, productivity systems, and dashboards."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Code</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Code. Automation. AI.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Engineering tools, automation frameworks, and productivity systems built to accelerate research and simulation workflows.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          <CategoryNav
            groups={navGroups}
            defaultView="project"
            ariaLabel="Code categories"
          />
        </div>
      </aside>

      <div class="flex-1 min-w-0">

        <!-- AI · Workflow -->
        <section data-view-panel="workflow" hidden aria-labelledby="cn-ai-trigger">
          <h2 class="view-title">AI · Workflow</h2>
          <div class="flex flex-col max-w-2xl">
            {workflowItems.map((p) => (
              <div class="card flex flex-col gap-3">
                <h4 class="card-title">{p.title}</h4>
                <p class="text-base" style="color: var(--body);">{p.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- AI · Harness Engineering -->
        <section data-view-panel="harness" hidden aria-labelledby="cn-ai-trigger">
          <h2 class="view-title">AI · Harness Engineering</h2>
          <div class="flex flex-col max-w-2xl">
            {harnessItems.map((p) => (
              <div class="card flex flex-col gap-3">
                <h4 class="card-title">{p.title}</h4>
                <p class="text-base" style="color: var(--body);">{p.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Project — all in black, all clickable -->
        <section data-view-panel="project" hidden aria-labelledby="cn-project-trigger">
          <h2 class="view-title">Project</h2>
          <div class="flex flex-col max-w-2xl">
            {projectItems.map((p) => {
              const real = projectEntry(p.existingSlug);

              if (real) {
                return (
                  <a href={`/development/${real.slug}`} class="card flex flex-col gap-3 group">
                    <h4 class="card-title">{real.data.title}</h4>
                    <p class="text-base" style="color: var(--body);">{real.data.summary}</p>
                    {real.data.tags && (
                      <div class="flex flex-wrap mt-1">
                        {real.data.tags.map(tag => <span class="chip">{tag}</span>)}
                      </div>
                    )}
                    <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                  </a>
                );
              }

              const href = p.externalHref ?? '#';
              const isExternal = !!p.externalHref && p.externalHref.startsWith('http');
              return (
                <a
                  href={href}
                  class="card flex flex-col gap-3 group"
                  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <h4 class="card-title">{p.title}</h4>
                  <p class="text-base" style="color: var(--body);">{p.summary}</p>
                  <span class="text-sm mt-1" style="color: var(--accent-dk);">View project →</span>
                </a>
              );
            })}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
  [data-view-panel] {
    transition: opacity 150ms ease;
  }
  [data-view-panel][hidden] {
    display: none;
  }
</style>
