---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('development');
const frameworks = allTools.filter(t => t.data.type === 'framework');

const renderEntries = async (entries: typeof allTools) =>
  await Promise.all(entries.map(async (entry) => {
    const { Content } = await entry.render();
    return { entry, Content };
  }));

const frameworksRendered = await renderEntries(frameworks);

const navGroups = [
  {
    key: 'ai',
    label: 'AI',
    trigger: 'expand' as const,
    items: [
      { view: 'workflow', label: 'Workflow' },
      { view: 'harness',  label: 'Harness Engineering' },
    ],
  },
  {
    key: 'project',
    label: 'Project',
    trigger: 'activate' as const,
    activateView: 'project',
  },
];

const workflowPlaceholders = [
  { title: 'Claude Desktop App', summary: 'Daily workflow patterns — task planning, research, writing, and review with the Claude desktop client.' },
  { title: 'Claude Code in VS Code', summary: 'Editor-integrated AI coding — slash commands, hooks, scoped permissions, and inline review loops.' },
  { title: 'Multi-Agent Orchestration', summary: 'Specialist subagents (developer / debugger / analyst / verifier) coordinated under an orchestrator pattern.' },
];

const harnessPlaceholders = [
  { title: 'MCP Servers', summary: 'Model Context Protocol — local and remote tool servers for filesystem, browser, EndNote, Notion, and scheduling.' },
  { title: 'Skills', summary: 'Reusable capability bundles for PDF, DOCX, XLSX, PPTX, design review, and research synthesis.' },
  { title: 'Hooks', summary: 'Event-driven automations — pre/post tool, session start/stop, and prompt submission gates.' },
  { title: 'Harness Dashboard', summary: 'Local HTML dashboard summarising the active MCP roster, enabled skills, and hook chain — ported view in progress.' },
];

const projectPlaceholders = [
  { title: 'Aspen Automation Framework', summary: 'Python pipeline for Aspen Plus — DOE, parallel simulation, surrogate training, NSGA-II / Bayesian optimization.', existingSlug: 'aspen-automation' },
  { title: 'SBH Thermal Simulation Framework', summary: 'ODE-based thermal framework — model / scenario / execution layers across 5 reactor configurations.', existingSlug: 'sbh-framework' },
  { title: 'Dashboard', summary: 'Local HTML dashboards for Pareto front, grid sweep, and weekly research updates — porting to the site in progress.', existingSlug: null },
  { title: 'Presentation', summary: 'Slide-format research updates and conference materials — annotated figures and methodology walkthroughs.', existingSlug: null },
  { title: 'Portfolio Site', summary: 'This very site — Astro + Tailwind + Cloudflare Pages. Source of truth for research, code, and recognition.', existingSlug: null },
];

function projectEntry(slug: string | null) {
  if (!slug) return null;
  return allTools.find((t) => t.slug === slug) ?? null;
}
---

<BaseLayout
  title="Code — Inseok Lee"
  description="Engineering tools, automation frameworks, productivity systems, and dashboards."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Code</span>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Code. Automation. AI.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Engineering tools, automation frameworks, and productivity systems built to accelerate research and simulation workflows.
      </p>
    </header>

    <div class="flex flex-col lg:flex-row lg:gap-12">

      <aside class="lg:w-56 flex-shrink-0 mb-8 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          <CategoryNav
            groups={navGroups}
            defaultView="project"
            ariaLabel="Code categories"
          />
        </div>
      </aside>

      <div class="flex-1 min-w-0">

        <!-- Workflow -->
        <section data-view-panel="workflow" hidden aria-labelledby="cn-ai-trigger">
          <h2 class="view-title">AI · Workflow</h2>
          <div class="flex flex-col max-w-2xl">
            {workflowPlaceholders.map((p) => (
              <div class="card flex flex-col gap-3" data-stub="true">
                <span class="section-label" style="color: var(--muted);">In preparation</span>
                <h4 class="card-title" style="color: var(--muted);">{p.title}</h4>
                <p class="text-base" style="color: var(--muted);">{p.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Harness Engineering -->
        <section data-view-panel="harness" hidden aria-labelledby="cn-ai-trigger">
          <h2 class="view-title">AI · Harness Engineering</h2>
          <div class="flex flex-col max-w-2xl">
            {harnessPlaceholders.map((p) => (
              <div class="card flex flex-col gap-3" data-stub="true">
                <span class="section-label" style="color: var(--muted);">In preparation</span>
                <h4 class="card-title" style="color: var(--muted);">{p.title}</h4>
                <p class="text-base" style="color: var(--muted);">{p.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Project -->
        <section data-view-panel="project" hidden aria-labelledby="cn-project-trigger">
          <h2 class="view-title">Project</h2>
          <div class="flex flex-col max-w-2xl">
            {projectPlaceholders.map((p) => {
              const real = projectEntry(p.existingSlug);
              if (real) {
                return (
                  <section class="card flex flex-col gap-3">
                    {real.data.date && <span class="section-label">{real.data.date}</span>}
                    <h4 class="card-title">{real.data.title}</h4>
                    <p class="text-base" style="color: var(--body);">{real.data.summary}</p>
                    {real.data.tags && (
                      <div class="flex flex-wrap mt-3">
                        {real.data.tags.map(tag => <span class="chip">{tag}</span>)}
                      </div>
                    )}
                  </section>
                );
              }
              return (
                <div class="card flex flex-col gap-3" data-stub="true">
                  <span class="section-label" style="color: var(--muted);">In preparation</span>
                  <h4 class="card-title" style="color: var(--muted);">{p.title}</h4>
                  <p class="text-base" style="color: var(--muted);">{p.summary}</p>
                </div>
              );
            })}
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .view-title {
    font-size: 1.75rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    color: var(--ink);
  }
  [data-view-panel] {
    transition: opacity 150ms ease;
  }
  [data-view-panel][hidden] {
    display: none;
  }
  [data-stub="true"] {
    opacity: 0.65;
  }
</style>
