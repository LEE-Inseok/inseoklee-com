---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('development');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

type Props = { entry: CollectionEntry<'development'> };
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, tags, date, images } = entry.data;
---

<BaseLayout title={`${title} — Inseok Lee`} description={summary} section="development">
  <ProjectDetail
    backHref="/development"
    backLabel="AI Engineering"
    title={title}
    summary={summary}
    date={date}
    tags={tags}
    images={images}
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
