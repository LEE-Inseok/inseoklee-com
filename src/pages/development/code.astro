---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Code & Frameworks — Development — Inseok Lee"
  description="Aspen Plus automation and SBH thermal simulation framework."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/development" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Development</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">Code & Frameworks.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        Aspen Plus automation · SBH thermal simulation framework · Python tooling
      </p>
    </header>

    <div class="max-w-2xl">
      <p class="text-base" style="color: var(--body);">
        [Development detail page — content coming in Day 4. Will include: Aspen automation
        framework overview and SBH thermal solver architecture.]
      </p>
    </div>
  </div>
</BaseLayout>
