---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const frameworks = (await getCollection('development')).filter(t => t.data.type === 'framework');

// Render each entry's content sequentially
const rendered = await Promise.all(frameworks.map(async (entry) => {
  const { Content } = await entry.render();
  return { entry, Content };
}));
---

<BaseLayout
  title="Code & Frameworks — Development — Inseok Lee"
  description="Aspen Plus automation and SBH thermal simulation framework."
>
  <div class="container-site py-16">
    <header class="mb-12 border-b pb-8" style="border-color: var(--border);">
      <a
        href="/development"
        class="section-label transition-colors"
        style="color: var(--muted);"
        onmouseover="this.style.color='var(--accent)';"
        onmouseout="this.style.color='var(--muted)';"
      >← Development</a>
      <h1 class="text-section mt-3" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif;">Code & Frameworks.</h1>
      <p class="mt-3 text-base max-w-2xl" style="color: var(--muted);">
        Python tooling that powers the simulation studies — each framework links to its GitHub repository.
      </p>
    </header>

    <div class="flex flex-col max-w-2xl">
      {rendered.map(({ entry, Content }, idx) => (
        <section class="card flex flex-col gap-3">
          <span class="section-label">{String(idx + 1).padStart(2, '0')} / {entry.data.type}</span>
          <h2 class="text-2xl mb-1" style="color: var(--ink); font-family: 'Fraunces', Georgia, serif; font-weight: 600;">{entry.data.title}</h2>
          <p class="text-base mb-2" style="color: var(--body);">{entry.data.summary}</p>
          <article class="article">
            <Content />
          </article>
          {entry.data.tags && (
            <div class="flex flex-wrap mt-4">
              {entry.data.tags.map(tag => <span class="chip">{tag}</span>)}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
