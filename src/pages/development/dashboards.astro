---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dashboards — Development — Inseok Lee"
  description="Real-time process monitoring and optimization result dashboards."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <a href="/development" class="section-label transition-colors" style="color: var(--muted);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--muted)';">← Development</a>
      <h1 class="text-section mt-3" style="color: var(--ink);">Dashboards.</h1>
      <p class="mt-3 text-base max-w-xl" style="color: var(--muted);">
        LOHC-CCPP dashboard · CCPP-LOHC presentation · weekly research tracker
      </p>
    </header>

    <div class="max-w-2xl">
      <p class="text-base" style="color: var(--body);">
        [Dashboards page — content coming in Day 4/5. Will include previews and
        iframe embeds or rebuilds of: lohc-ccpp-dashboard, ccpp-lohc-presentation,
        and weekly_web tracker.]
      </p>
    </div>
  </div>
</BaseLayout>
