---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Inseok Lee"
  description="Get in touch with Inseok Lee — email, LinkedIn, GitHub."
>
  <div class="container-site py-16">
    <header class="mb-16 border-b pb-8" style="border-color: var(--border);">
      <span class="section-label">Contact</span>
      <h1 class="text-section mt-3" style="color: var(--ink);">Get in touch.</h1>
    </header>

    <div class="max-w-2xl flex flex-col gap-12">
      <!-- Emails -->
      <div>
        <p class="section-label mb-4">Email</p>
        <div class="flex flex-col gap-3">
          <a
            href="mailto:inseok888@gmail.com"
            class="flex items-center gap-3 group"
          >
            <span class="text-xs uppercase tracking-widest px-2 py-0.5 font-medium" style="background: var(--accent); color: #FFFFFF;">Primary</span>
            <span class="text-sm transition-colors duration-150" style="color: var(--body);" onmouseover="this.style.color='var(--accent)';" onmouseout="this.style.color='var(--body)';">inseok888@gmail.com</span>
          </a>
          <a href="mailto:ericque@naver.com" class="text-sm transition-colors duration-150" style="color: var(--muted);" onmouseover="this.style.color='var(--body)';" onmouseout="this.style.color='var(--muted)';">ericque@naver.com</a>
          <a href="mailto:ericfivefin@korea.ac.kr" class="text-sm transition-colors duration-150" style="color: var(--muted);" onmouseover="this.style.color='var(--body)';" onmouseout="this.style.color='var(--muted)';">
            ericfivefin@korea.ac.kr <span class="text-xs ml-1">(KU)</span>
          </a>
          <a href="mailto:t25104@kist.re.kr" class="text-sm transition-colors duration-150" style="color: var(--muted);" onmouseover="this.style.color='var(--body)';" onmouseout="this.style.color='var(--muted)';">
            t25104@kist.re.kr <span class="text-xs ml-1">(KIST)</span>
          </a>
        </div>
      </div>

      <!-- Social -->
      <div>
        <p class="section-label mb-4">Profiles</p>
        <div class="flex flex-col gap-3">
          <a
            href="https://www.linkedin.com/in/inseok-lee-9085563a7"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-sm transition-colors duration-150"
            style="color: var(--body);"
            onmouseover="this.style.color='var(--accent)';"
            onmouseout="this.style.color='var(--body)';"
          >
            LinkedIn <span style="color: var(--muted);">linkedin.com/in/inseok-lee-9085563a7</span>
          </a>
          <a
            href="https://github.com/LEE-Inseok"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-sm transition-colors duration-150"
            style="color: var(--body);"
            onmouseover="this.style.color='var(--accent)';"
            onmouseout="this.style.color='var(--body)';"
          >
            GitHub <span style="color: var(--muted);">github.com/LEE-Inseok</span>
          </a>
        </div>
      </div>

      <!-- CV -->
      <div>
        <p class="section-label mb-4">Curriculum Vitae</p>
        <a
          href="/cv.en.pdf"
          class="inline-flex items-center gap-2 px-6 py-3 text-sm uppercase tracking-widest transition-colors duration-150"
          style="border: 1px solid var(--border); color: var(--body);"
          onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
          onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--body)';"
          download
        >
          Download CV (EN) →
        </a>
        <p class="text-xs mt-2" style="color: var(--muted);">[PDF to be added by user]</p>
      </div>

      <p class="text-sm" style="color: var(--muted);">I usually respond within 1–2 days.</p>
    </div>
  </div>
</BaseLayout>
